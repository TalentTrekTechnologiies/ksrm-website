# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/ksrm_cms?schema=public"

# Secret used to sign/verify admin JWTs (required). Use a long, random value in
# every environment - there is no safe default and the app will refuse to
# start without this set.
JWT_SECRET="replace-with-a-long-random-string"

# Port the NestJS server listens on (optional, defaults to 4000)
PORT=4000

# Origin allowed to call this API with credentials (optional, defaults to
# http://localhost:3000 - the frontend's local dev URL)
CORS_ORIGIN="http://localhost:3000"

# development | production | test (optional; currently used to gate Swagger)
NODE_ENV="development"

# Media Library: absolute origin this backend serves uploaded files from
# (optional, defaults to http://localhost:{PORT}). A future S3/CloudFront
# migration changes this to the CDN's origin - no application code changes.
MEDIA_BASE_URL="http://localhost:4000"

# Media Library: local-disk storage root (optional, defaults to
# ./storage/media relative to the backend's working directory). Ignored
# entirely once a non-local StorageAdapter is configured.
MEDIA_STORAGE_ROOT="./storage/media"

# --- Email (NotificationService) ---
# Selects the EmailProvider implementation (see backend/src/mailer/).
# Application code never depends on a specific provider - only on
# NotificationService. Swapping this is the entire migration.
#   console -> logs instead of sending (default, zero-config, safe for
#              local dev/CI/tests with no email infra set up)
#   smtp    -> Gmail SMTP or Mailpit (dev), any SMTP server (uses SMTP_* below)
#   ses     -> AWS SES (production; uses AWS_* below)
EMAIL_PROVIDER="console"

# From-address used by every outbound email (optional, defaults below)
EMAIL_FROM="no-reply@ksrmce.ac.in"

# Mailbox that receives HR notifications for new job applications (required
# once EMAIL_PROVIDER is not "console" and Careers applications go live)
HR_NOTIFICATION_EMAIL="hr@ksrmce.ac.in"

# --- SMTP (only read when EMAIL_PROVIDER=smtp) ---
# Mailpit (local dev, no auth): SMTP_HOST=localhost SMTP_PORT=1025
# Gmail SMTP: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false,
#   SMTP_USER=your@gmail.com, SMTP_PASS=<16-char App Password, not your
#   real Gmail password - Google requires 2FA + an App Password for SMTP>
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- AWS SES (only read when EMAIL_PROVIDER=ses) ---
# Falls back to the default AWS credential provider chain (IAM role, shared
# config file) when AWS_ACCESS_KEY_ID is unset - never required to hardcode
# credentials here in a real AWS deployment.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Careers Application Pipeline ---
# Minimum hours before the same email can re-apply to the same posting
# (duplicate-submission prevention; optional, defaults to 24)
CAREER_APPLICATION_DUPLICATE_WINDOW_HOURS=24
