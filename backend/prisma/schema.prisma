  committeeId Int
  facultyId   Int?
  name        String
  designation String
  role        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  committee      Committee @relation("CommitteeMember_Committee", fields: [committeeId], references: [id], onDelete: Cascade)
  faculty        Faculty?  @relation("CommitteeMember_Faculty", fields: [facultyId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?    @relation("CommitteeMember_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

