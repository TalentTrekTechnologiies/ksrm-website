generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// PHASE 1 - ADDITIVE ONLY
//
// Every model below that existed before this migration keeps every one of its
// existing fields, with the exact same name/type/nullability/default it had
// before. New fields on existing models are grouped under a clearly marked
// "Phase 1 additive fields" comment. No existing column is renamed, retyped,
// or dropped. No data is backfilled by this migration - new FK/lookup columns
// are nullable and unpopulated until a later, separate migration.
//
// See backend/DATA_MODEL_DESIGN.md for the full design rationale, the
// migration phase plan, and the list of items explicitly deferred out of
// Phase 1 (§5.5: Notification -> TickerNotice rename; Research.type /
// AuditLog.action enum conversions;
// AuditLog.adminId FK constraint; RBAC assignment to existing admins).
// =============================================================================

// -----------------------------------------------------------------------------
// ENUMS (all new - none of these existed before Phase 1)
// -----------------------------------------------------------------------------

enum OutcomeType {
  PEO
  PO
  PSO
}

enum ProgrammeLevel {
  UG
  PG
  PHD
  DIPLOMA
}

// Department CMS phase - DepartmentHighlight now serves both the "AI
// Highlights" promo cards and Achievements (awards/rankings/accolades) via
// this discriminator, instead of a near-duplicate second table - same
// shape (title/description/sortOrder/isActive/soft-delete), different
// section on the public page.
enum DepartmentHighlightKind {
  HIGHLIGHT
  ACHIEVEMENT
}

/// Restricted to committees that actually exist on the current site today
/// (Anti-Ragging, Grievance Redressal). OTHER is the escape hatch for a
/// future committee rather than a speculative pre-seeded type - no
/// Women's-Cell/SC-ST-Cell values are included since no such page/content
/// exists yet (per explicit instruction: don't invent future committee data).
enum CommitteeType {
  ANTI_RAGGING
  GRIEVANCE_REDRESSAL
  /// The institution's Governing Body, rendered as its own section on the
  /// About page. A dedicated type rather than an OTHER committee named
  /// "Governing Body": the public page selects on type, so renaming the
  /// committee in the CMS can never silently empty that section.
  GOVERNING_BODY
  /// The IQAC's own 35-member composition, listed on the IQAC page. Same
  /// shape as any other committee, so it is maintained in the same screen
  /// rather than being a hardcoded table only a developer can change.
  IQAC
  OTHER
}

enum CategoryDomain {
  NEWS
  GALLERY
  EXAM_NOTIFICATION
  DOWNLOAD
}

enum DownloadCategory {
  SYLLABUS
  QUESTION_PAPER
  BROCHURE
  AFFIDAVIT
  FORM
  OTHER
}

/// Value-type hint for SiteSetting.value, so the admin UI knows how to
/// render/validate a setting without special-casing every key by name.
enum SiteSettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  URL
  EMAIL
  IMAGE_URL
}

/// Homepage CMS (Sprint 1B). Deliberately just 2 values for now - SCHEDULED
/// is added later (Sprint 1D) alongside real publishAt/expiresAt evaluation
/// logic; Postgres enums extend additively so reserving the value now isn't
/// needed and would just be dead until 1D wires it up. The admin UI's status
/// badge already color-codes for a future "Scheduled" state, it just can't
/// be reached yet.
enum SectionStatus {
  DRAFT
  PUBLISHED
}

// -----------------------------------------------------------------------------
// EXISTING MODELS - untouched original fields, additive columns only
// -----------------------------------------------------------------------------

model News {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String
  imageUrl    String?
  date        DateTime
  isPublished Boolean  @default(true)
  /// Sprint 1C - lets the homepage's Latest News section prioritize
  /// hand-picked stories instead of always showing just the N most recent.
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Phase 1 additive fields ---
  slug          String?   @unique
  categoryId    Int?
  authorAdminId Int?
  deletedAt     DateTime?
  deletedBy     Int?
  version       Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as HomepageHero.mediaId /
  /// GalleryImage.mediaId). imageUrl stays authoritative for existing rows
  /// and legacy manual-URL saves; when set, the server resolves this to the
  /// Media Library's current URL for that asset on every read/write so
  /// Replace propagates without a News re-save.
  mediaId Int?
  /// Optional video and document attachments, alongside the image.
  videoUrl        String?
  videoMediaId    Int?
  documentUrl     String?
  documentMediaId Int?

  categoryRef    Category? @relation("News_Category", fields: [categoryId], references: [id], onDelete: SetNull)
  authorAdmin    Admin?    @relation("News_Author", fields: [authorAdminId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?    @relation("News_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([authorAdminId])
  @@index([deletedAt])
}

model Faculty {
  id             Int      @id @default(autoincrement())
  name           String
  designation    String
  qualification  String
  department     String
  specialization String?
  experience     String?
  email          String?
  phone          String?
  photoUrl       String?
  isHod          Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // --- Phase 1 additive fields ---
  departmentId   Int?
  welcomeMessage String?
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  deletedBy      Int?
  version        Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as HomepageHero.mediaId / GalleryImage
  /// .mediaId / News.mediaId / Event.mediaId). photoUrl stays authoritative
  /// for existing rows and legacy manual-URL saves; when set, the server
  /// resolves this to the Media Library's current URL for that asset on
  /// every read/write so Replace propagates without a Faculty re-save.
  mediaId Int?

  departmentRef        Department?       @relation("Faculty_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  hodOfDepartment      Department?       @relation("Department_Hod")
  deletedByAdmin       Admin?            @relation("Faculty_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  labsInCharge         Lab[]             @relation("Lab_InCharge")
  committeeMemberships CommitteeMember[] @relation("CommitteeMember_Faculty")
  researchRecords      Research[]        @relation("Research_Faculty")
  achievements         FacultyAchievement[] @relation("FacultyAchievement_Faculty")

  @@index([departmentId])
  @@index([isActive])
  @@index([deletedAt])
}

/// What a faculty achievement record represents. One table rather than a
/// separate model per kind: they carry the same fields (a title, who published
/// or granted it, a reference number, a date) and are always shown together on
/// a profile, so splitting them would mean four near-identical modules.
enum FacultyAchievementType {
  PUBLICATION
  PATENT
  BOOK
  AWARD
  CERTIFICATION
  /// A named identifier or profile link - Scopus ID, ORCID, Vidwan, Google
  /// Scholar. Uses the same row shape (title = the label, detail = the value),
  /// so an admin can record any identifier that comes along without waiting for
  /// a schema change for each one.
  PROFILE_ID
  /// A free label/value pair for anything the fixed Faculty columns do not
  /// cover - "Date of Joining", "Languages Known", "Membership". Same row
  /// shape again (title = the label, detail = the value), so a new kind of
  /// detail never needs a migration. Shown with the profile's other details
  /// rather than as an achievement list.
  DETAIL
}

/// A publication, patent, book, award or certification belonging to one faculty
/// member.
///
/// Staff accumulate these every year - four papers and a patent is a normal
/// annual haul. They are rows against the existing Faculty record rather than
/// fields on it, so adding this year's work never means duplicating a person.
model FacultyAchievement {
  id        Int                    @id @default(autoincrement())
  facultyId Int
  type      FacultyAchievementType
  title     String
  /// Journal, conference, publisher, or the authority that granted it.
  detail    String?
  /// DOI, ISSN/ISBN, patent or application number - whatever identifies it.
  referenceNo String?
  /// Date of publication, or date of issue for a patent. Nullable because
  /// older records are often remembered only by year, and a filed-but-not-yet
  /// granted patent has no issue date at all.
  date      DateTime?
  /// Free text so "Granted", "Filed", "Published" all fit without a migration.
  status    String?
  url       String?
  sortOrder Int                    @default(0)
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  faculty        Faculty @relation("FacultyAchievement_Faculty", fields: [facultyId], references: [id], onDelete: Cascade)
  deletedByAdmin Admin?  @relation("FacultyAchievement_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([facultyId])
  @@index([type])
  @@index([deletedAt])
}

model Placement {
  id          Int      @id @default(autoincrement())
  studentName String
  company     String
  package     String
  department  String
  year        Int
  imageUrl    String?
  createdAt   DateTime @default(now())

  // --- Phase 1 additive fields ---
  departmentId   Int?
  companyLogoUrl String?
  isPublished    Boolean   @default(true)
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?
  deletedBy      Int?
  version        Int       @default(1)

  /// Media Library references (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as the other modules' mediaId columns).
  /// imageUrl/companyLogoUrl stay authoritative for existing rows and
  /// legacy manual-URL saves.
  mediaId          Int?
  companyLogoMediaId Int?

  departmentRef  Department? @relation("Placement_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?      @relation("Placement_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([deletedAt])
}

model GalleryImage {
  id        Int       @id @default(autoincrement())
  title     String
  imageUrl  String
  category  String
  date      DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  // --- Phase 1 additive fields ---
  categoryId   Int?
  departmentId Int?
  sortOrder    Int       @default(0)
  deletedAt    DateTime?
  deletedBy    Int?
  version      Int       @default(1)

  /// Optional page/section slug (e.g. "edc", "iic", "library") that routes
  /// this image to a specific public page's gallery block, parallel to
  /// Download.pageSection. Null = not tied to a page (still appears in the
  /// general Gallery). Free string, driven by the admin UI's PAGE_SECTIONS.
  pageSection  String?

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as HomepageHero.mediaId). imageUrl stays
  /// authoritative for existing rows and legacy manual-URL saves; when set,
  /// this is kept in sync with the Media Library's current URL for that
  /// asset server-side, so Replace propagates with no re-save needed.
  mediaId Int?

  categoryRef    Category?   @relation("GalleryImage_Category", fields: [categoryId], references: [id], onDelete: SetNull)
  departmentRef  Department? @relation("GalleryImage_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?      @relation("GalleryImage_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([departmentId])
  @@index([deletedAt])
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  isSuperAdmin Boolean  @default(false)
  permissions  String[] // "faculty", "news", "gallery", "placements", "exam", "notifications", "research", "degree_verification", "admins"
  department   String? // optional, for faculty management
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Phase 1 additive fields ---
  // NOTE: `permissions` (above) stays untouched in Phase 1. Roles are seeded
  // (see prisma/seed.ts) but NOT yet assigned to any existing admin - that
  // assignment is an explicit, separate, reviewed data migration (see
  // DATA_MODEL_DESIGN.md §9 Phase 5), not part of this additive migration.
  departmentId Int?
  lastLoginAt  DateTime?

  // Admin Management module - soft-delete + optimistic locking, same
  // pattern as every other CMS module. `isActive` (above) stays the
  // separate enable/disable toggle (a disabled admin still exists and is
  // restorable without going through delete/restore); deletedAt is for
  // actually removing an admin account from the active roster.
  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  departmentRef  Department? @relation("Admin_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?      @relation("Admin_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  deletedAdmins  Admin[]     @relation("Admin_DeletedBy")

  roles         AdminRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  authoredNews News[] @relation("News_Author")

  // Reverse side of every `deletedBy` FK across the schema - see
  // DATA_MODEL_DESIGN.md §5 for the soft-delete matrix these correspond to.
  deletedNews                 News[]                @relation("News_DeletedBy")
  deletedFaculty              Faculty[]             @relation("Faculty_DeletedBy")
  deletedFacultyAchievements  FacultyAchievement[]  @relation("FacultyAchievement_DeletedBy")
  deletedPlacements           Placement[]           @relation("Placement_DeletedBy")
  deletedGalleryImages        GalleryImage[]        @relation("GalleryImage_DeletedBy")
  deletedLabs                 Lab[]                 @relation("Lab_DeletedBy")
  deletedDepartments          Department[]          @relation("Department_DeletedBy")
  deletedLearningOutcomes     LearningOutcome[]     @relation("LearningOutcome_DeletedBy")
  deletedDepartmentProgrammes DepartmentProgramme[] @relation("DepartmentProgramme_DeletedBy")
  deletedDepartmentHighlights DepartmentHighlight[] @relation("DepartmentHighlight_DeletedBy")
  deletedDownloads            Download[]            @relation("Download_DeletedBy")
  deletedCommittees           Committee[]           @relation("Committee_DeletedBy")
  deletedCommitteeMembers     CommitteeMember[]     @relation("CommitteeMember_DeletedBy")
  updatedSiteSettings         SiteSetting[]         @relation("SiteSetting_UpdatedBy")

  // Reverse side of the page-driven content entities added after the
  // frontend content audit (see DATA_MODEL_DESIGN.md's Page-Driven Content
  // Entities section).
  deletedPageBanners         PageBanner[]         @relation("PageBanner_DeletedBy")
  deletedSiteStatistics      SiteStatistic[]      @relation("SiteStatistic_DeletedBy")
  deletedContactChannels     ContactChannel[]     @relation("ContactChannel_DeletedBy")
  deletedTestimonials        Testimonial[]        @relation("Testimonial_DeletedBy")
  deletedCampusVideos        CampusVideo[]        @relation("CampusVideo_DeletedBy")
  deletedAccreditationBadges AccreditationBadge[] @relation("AccreditationBadge_DeletedBy")
  deletedRecruiters          Recruiter[]          @relation("Recruiter_DeletedBy")
  deletedFaqs                Faq[]                @relation("Faq_DeletedBy")
  deletedLeadershipProfiles  LeadershipProfile[]  @relation("LeadershipProfile_DeletedBy")
  deletedContentCards        ContentCard[]        @relation("ContentCard_DeletedBy")

  // Homepage CMS (Sprint 1A).
  deletedHomepageHeroes HomepageHero[] @relation("HomepageHero_DeletedBy")

  // Homepage CMS (Sprint 1B).
  deletedHomepageSections HomepageSection[] @relation("HomepageSection_DeletedBy")

  // New content modules (Careers, Events).
  deletedCareers Career[] @relation("Career_DeletedBy")
  deletedEvents  Event[]  @relation("Event_DeletedBy")

  // Media Library.
  uploadedMedia           Media[]        @relation("Media_UploadedBy")
  deletedTransportRoutes TransportRoute[] @relation("TransportRoute_DeletedBy")
  deletedMedia            Media[]        @relation("Media_DeletedBy")
  mediaVersionsReplacedBy MediaVersion[] @relation("MediaVersion_ReplacedBy")

  // Department CMS phase.
  departmentDisplaySettingsUpdated DepartmentDisplaySetting[] @relation("DepartmentDisplaySetting_UpdatedBy")

  // Careers Application Pipeline.
  assignedCareerApplications    CareerApplication[]                @relation("CareerApplication_AssignedHr")
  careerApplicationStatusChanges CareerApplicationStatusHistory[]  @relation("CareerApplicationStatusHistory_ChangedBy")

  // Announcement Engine.
  deletedAnnouncements Announcement[] @relation("Announcement_DeletedBy")

  // In-App Notification Center (Premium UI Redesign).
  notifications AdminNotification[] @relation("AdminNotification_Admin")

  @@index([departmentId])
  @@index([deletedAt])
}

model Research {
  id         Int      @id @default(autoincrement())
  title      String
  authors    String
  journal    String?
  year       Int
  department String
  type       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // --- Phase 1 additive fields ---
  // NOTE: `type` (above) is NOT converted to the planned `ResearchType` enum
  // in Phase 1 - see DATA_MODEL_DESIGN.md §5.5 (deferred, same reasoning as
  // the other existing-column type changes). Research is also intentionally
  // NOT given soft-delete columns - it wasn't in the approved soft-delete
  // scope list (Faculty/Labs/News/Gallery/Downloads/Placements/Committees/
  // Department content); `isActive` already serves as its hide/show toggle.
  departmentId Int?
  doiOrLink    String?
  updatedAt    DateTime @default(now()) @updatedAt

  /// Media Library reference for an optional attachment (paper/patent PDF)
  /// - DOCUMENT type, resolved the same way as every other module's
  /// mediaId column. attachmentUrl stays authoritative for legacy
  /// manual-URL saves.
  mediaId       Int?
  attachmentUrl String?

  departmentRef Department? @relation("Research_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  facultyRef    Faculty?    @relation("Research_Faculty", fields: [facultyId], references: [id], onDelete: SetNull)
  facultyId     Int?

  @@index([departmentId])
  @@index([facultyId])
  @@index([year])
}

model ExamNotification {
  id       Int      @id @default(autoincrement())
  title    String
  // --- Legacy Phase 1 fields, no longer written by the current
  // (deliberately simple - "publish an important link, not a notification
  // engine") admin form. Kept rather than dropped, matching this schema's
  // additive-only convention - see startDate/endDate/isPublished below for
  // the fields that replaced date/category's role. Table had zero rows at
  // migration time, so nothing needed backfilling.
  fileUrl  String?
  category String?
  date     DateTime?
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())

  // --- Admin Management rework ---
  description String?
  buttonText  String?
  buttonUrl   String?
  startDate   DateTime
  endDate     DateTime?
  // Separate from isActive: isPublished is the draft/live gate an editor
  // toggles deliberately; isActive stays available as a quick
  // enable/disable that doesn't lose the "published" state. Public display
  // requires both, plus falling inside [startDate, endDate].
  isPublished Boolean  @default(false)

  // --- Phase 1 additive fields ---
  // NOTE: also intentionally not given soft-delete columns - same reasoning
  // as Research (not in the approved soft-delete scope list).
  categoryId   Int?
  departmentId Int?
  // Academic year this notification belongs to, e.g. "AY 2026-27". Free text
  // (not an enum) so a new year needs no migration. The public list groups by
  // this, newest year first, so the current year's notifications sit on top and
  // previous years collect underneath. Null = ungrouped (shown last).
  academicYear String?
  updatedAt    DateTime @default(now()) @updatedAt

  /// Which list on the Examinations page this appears under.
  type ExamNotificationType @default(NOTIFICATION)

  /// The attached file (result sheet, timetable, question paper). mediaId is
  /// the Media Library link; fileUrl stays for a plain external URL and for
  /// the rows that predate the Media Library.
  mediaId Int?

  categoryRef   Category?   @relation("ExamNotification_Category", fields: [categoryId], references: [id], onDelete: SetNull)
  departmentRef Department? @relation("ExamNotification_Department", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([departmentId])
  @@index([isPublished])
  @@index([isActive])
}

// Audit Log for tracking admin actions
model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  adminName  String
  adminEmail String
  action     String // "CREATE" | "UPDATE" | "DELETE"
  module     String // "faculty" | "news" | "gallery" | "placements" | "exam" | "notifications" | "degree_verification"
  targetId   Int? // ID of the affected record
  details    String? // JSON string with changes
  ipAddress  String? // IP address of the admin
  createdAt  DateTime @default(now())

  // --- Phase 1 additive fields ---
  // NOTE: `adminId` (above) does NOT get an FK constraint added in Phase 1.
  // Adding one now would require every existing AuditLog.adminId value to
  // already reference a real Admin.id, which hasn't been verified against
  // live data - a constraint that could fail partway through applying is
  // exactly the kind of risk Phase 1 is designed to avoid. The real FK
  // (`adminRef`, nullable, SetNull) is added here as a NEW, separate,
  // unenforced-until-backfilled column; the plain `adminId` Int stays
  // exactly as it was. See DATA_MODEL_DESIGN.md §5.5 and §9 Phase 4.
  // `action` also stays a free String in Phase 1 for the same reason - the
  // AuditAction enum conversion is deferred alongside it.
  adminRefId Int?

  // Homepage CMS (Sprint 1A) - the correlation ID from the existing
  // request-id middleware (see common/middleware/request-id.middleware.ts),
  // so a single HTTP request's audit entries can be traced back to the
  // request that produced them. Nullable/additive: existing audit rows
  // predate this middleware and never had a request ID to record.
  requestId String?

  adminRef Admin? @relation(fields: [adminRefId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([module])
  @@index([createdAt])
  @@index([module, createdAt])
  @@index([adminRefId])
}

// -----------------------------------------------------------------------------
// NEW MODELS
// -----------------------------------------------------------------------------

model Department {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  shortName       String?
  tagline         String?
  intro           String?
  about           String
  aboutVideoUrl   String?
  heroImageUrl    String?
  vision          String?
  mission         String[]
  establishedYear Int?
  hodId           Int?     @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Added after the frontend content audit: department pages, like almost
  // every other page on the site, currently inherit only the root layout's
  // title/description with no per-page override.
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  // Soft delete + optimistic locking - "Department content" is explicitly
  // in the approved soft-delete scope.
  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Media Library reference for heroImageUrl (plain Int, no Prisma
  /// relation - same decoupled-by-design reasoning as the other modules'
  /// mediaId columns). Only heroImageUrl is Media Picker-integrated this
  /// pass, matching what the admin form actually exposes today;
  /// aboutVideoUrl/ogImageUrl have no admin UI field yet so they're left on
  /// their plain string columns.
  heroMediaId Int?

  hod            Faculty? @relation("Department_Hod", fields: [hodId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?   @relation("Department_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  faculties           Faculty[]             @relation("Faculty_Department")
  labs                Lab[]                 @relation("Lab_Department")
  researches          Research[]            @relation("Research_Department")
  placements          Placement[]           @relation("Placement_Department")
  learningOutcomes    LearningOutcome[]     @relation("LearningOutcome_Department")
  programmes          DepartmentProgramme[] @relation("DepartmentProgramme_Department")
  highlights          DepartmentHighlight[] @relation("DepartmentHighlight_Department")
  galleryImages       GalleryImage[]        @relation("GalleryImage_Department")
  examNotifications   ExamNotification[]    @relation("ExamNotification_Department")
  downloads           Download[]            @relation("Download_Department")
  admins              Admin[]               @relation("Admin_Department")

  // Department CMS phase.
  campusVideos    CampusVideo[]           @relation("CampusVideo_Department")
  siteStatistics  SiteStatistic[]         @relation("SiteStatistic_Department")
  contactChannels ContactChannel[]        @relation("ContactChannel_Department")
  displaySettings DepartmentDisplaySetting[] @relation("DepartmentDisplaySetting_Department")

  // Announcement Engine.
  announcementPlacements AnnouncementPlacement[] @relation("AnnouncementPlacement_Department")

  @@index([isActive])
  @@index([deletedAt])
}

// Department CMS phase - the "scalable configuration" system: one row per
// toggle (key/value), not one boolean column per toggle. Adding a new
// display option later (e.g. "faculty.showLinkedIn") is an INSERT, never a
// migration. Mirrors the same key/value-row pattern already proven for
// homepage section visibility (SiteSetting group: 'homepage_visibility'),
// just scoped by a real FK instead of a string-parsed group name since
// every row here already belongs to exactly one department.
//
// `key` convention: "<section>.<option>", e.g. "faculty.showPhotos",
// "hod.showMessage", "labs.showEquipment", "research.showVideos". Absence
// of a row for a given key means "on" (default-visible) - only OFF states
// need to be written, so a brand-new department starts with every section
// fully visible without needing thousands of seeded rows.
model DepartmentDisplaySetting {
  id           Int      @id @default(autoincrement())
  departmentId Int
  key          String
  value        Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  updatedBy    Int?

  department     Department @relation("DepartmentDisplaySetting_Department", fields: [departmentId], references: [id], onDelete: Cascade)
  updatedByAdmin Admin?     @relation("DepartmentDisplaySetting_UpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([departmentId, key])
  @@index([departmentId])
}

model LearningOutcome {
  id           Int         @id @default(autoincrement())
  departmentId Int
  type         OutcomeType
  code         String
  title        String?
  text         String
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  department     Department @relation("LearningOutcome_Department", fields: [departmentId], references: [id], onDelete: Cascade)
  deletedByAdmin Admin?     @relation("LearningOutcome_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@unique([departmentId, type, code])
  @@index([departmentId, type])
  @@index([deletedAt])
}

model DepartmentProgramme {
  id           Int            @id @default(autoincrement())
  departmentId Int
  name         String
  level        ProgrammeLevel
  intake       Int
  /// Course/branch code as printed on the Courses & Intake table (e.g. "CSE",
  /// "05"). Optional: not every programme has one, and the table shows the
  /// department's short name when it is absent.
  code          String?
  /// Accreditation badge for this specific programme, e.g. "NBA Accredited".
  /// Optional and deliberately free text - it is a claim about this branch
  /// only, so it is never inferred or defaulted.
  accreditation String?
  sortOrder    Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  department     Department @relation("DepartmentProgramme_Department", fields: [departmentId], references: [id], onDelete: Cascade)
  deletedByAdmin Admin?     @relation("DepartmentProgramme_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([deletedAt])
}

model DepartmentHighlight {
  id           Int                      @id @default(autoincrement())
  departmentId Int
  kind         DepartmentHighlightKind  @default(HIGHLIGHT)
  title        String
  description  String
  sortOrder    Int                      @default(0)
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as every other module's mediaId
  /// column). Optional - highlight/achievement cards work text-only too.
  mediaId  Int?
  imageUrl String?

  department     Department @relation("DepartmentHighlight_Department", fields: [departmentId], references: [id], onDelete: Cascade)
  deletedByAdmin Admin?     @relation("DepartmentHighlight_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([departmentId, kind])
  @@index([deletedAt])
}

model Lab {
