/// Sprint "tonight" build - job openings shown on the public Careers page.
/// `employmentType` kept as a plain string (not an enum) for build speed;
/// tighten to an enum later if the values need real validation.
model Career {
  id             Int       @id @default(autoincrement())
  title          String
  department     String?
  employmentType String?
  location       String?
  description    String
  applyUrl       String?
  applyEmail     String?
  postedAt       DateTime  @default(now())
  closingAt      DateTime?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Career_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  applications CareerApplication[]

  @@index([isActive])
  @@index([deletedAt])
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  SELECTED
  REJECTED
  JOINED
}

/// Careers Application Pipeline. Deliberately no soft-delete/version
/// columns - this is a compliance-adjacent HR record, corrected by status
/// transition (tracked in CareerApplicationStatusHistory), never deleted
/// through the admin UI.
model CareerApplication {
  id       Int     @id @default(autoincrement())
  careerId Int?

  fullName          String
  email             String
  mobile            String
  address           String?
  dateOfBirth       DateTime?
  qualification     String
  specialization    String?
  yearsOfExperience Float?
  currentCompany    String?
  currentCtc        String?
  expectedCtc       String?
  noticePeriod      String?
  skills            String[]
  linkedinUrl       String?
  portfolioUrl      String?

  /// Media Library reference (DOCUMENT type) - the resume is a Media
  /// Library asset like every other file in this system, reusing its
  /// validation/versioning/storage-tracking pipeline rather than a
  /// separate resume storage mechanism. resumeUrl is the resolved URL at
  /// submission time (kept for display without an extra Media lookup on
  /// every list render - same denormalization pattern every mediaId field
  /// in this schema already uses for its legacy-URL sibling column).
  resumeMediaId Int
  resumeUrl     String

  coverLetter     String?
  additionalNotes String?

  source ApplicationSource @default(WEBSITE)
  status ApplicationStatus @default(APPLIED)
  notes  String?

  assignedHrId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  career        Career?                          @relation(fields: [careerId], references: [id], onDelete: SetNull)
  assignedHr    Admin?                            @relation("CareerApplication_AssignedHr", fields: [assignedHrId], references: [id], onDelete: SetNull)
  statusHistory CareerApplicationStatusHistory[]

  @@index([careerId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum ApplicationSource {
  WEBSITE
  REFERRAL
  MANUAL
}

/// The timeline: Applied -> Resume Reviewed -> Interview Scheduled ->
/// Selected, etc. One append-only row per status transition.
model CareerApplicationStatusHistory {
  id               Int               @id @default(autoincrement())
  applicationId    Int
  status           ApplicationStatus
  note             String?
  changedByAdminId Int?
  createdAt        DateTime          @default(now())

  application    CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedByAdmin Admin?            @relation("CareerApplicationStatusHistory_ChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

enum AnnouncementPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

/// Free-text-adjacent classification of where an announcement originated -
/// not a hard FK into News/Event/etc (an announcement can be pure MANUAL
/// content with no source record at all). sourceModule/sourceRecordId
/// below optionally point back at the originating row, same loose
/// module+recordId pattern MediaUsage/AuditLog already use, so this model
/// never needs to know the shape of News/Event/ExamNotification.
enum AnnouncementSource {
  NEWS
  EXAM_NOTIFICATION
  EVENT
  PLACEMENT
  ADMISSION
  MANUAL
  EMERGENCY
}

enum AnnouncementLocation {
  HEADER_TICKER
  HERO_BANNER
  HOMEPAGE_SECTION
  DEPARTMENT_PAGE
  ADMISSIONS_PAGE
  PLACEMENTS_PAGE
  EXAM_NOTIFICATIONS_PAGE
}

/// The centralized Announcement Engine - one record, reusable across every
/// display location via AnnouncementPlacement rows below, instead of a
/// separate ticker/banner system per page. "Show in Header"/"Show in Hero"
/// etc are not boolean columns here - they're the presence/absence of a
/// placement row for that location, matching this project's established
/// "one row per toggle" scalable-configuration pattern (see
/// DepartmentDisplaySetting).
model Announcement {
  id          Int     @id @default(autoincrement())
  title       String
  /// Condensed text for ticker display - falls back to `title` when unset
  /// (a homepage section card can afford a longer title; a scrolling
  /// ticker strip usually can't).
  shortText   String?
  description String?
  icon        String?
  badge       String?

  priority AnnouncementPriority @default(NORMAL)
  /// Optional override color (hex) - absent means the priority's own
  /// default color scheme applies (see the frontend's PRIORITY_COLORS map).
  color    String?

  source         AnnouncementSource @default(MANUAL)
  sourceModule   String?
  sourceRecordId Int?

  linkUrl      String?
  openInNewTab Boolean @default(false)

  startDate   DateTime?
  endDate     DateTime?
  isPublished Boolean   @default(false)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin?                   @relation("Announcement_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  placements     AnnouncementPlacement[]

  @@index([isActive])
  @@index([isPublished])
  @@index([deletedAt])
  @@index([startDate, endDate])
}

/// The reusability join: one row per (announcement, location[, department])
/// combination. A single Announcement can have a HEADER_TICKER placement
/// and a HOMEPAGE_SECTION placement simultaneously - two rows, one source
/// of truth for the content itself (title/priority/dates/link all live on
/// Announcement, never duplicated per placement).
model AnnouncementPlacement {
  id             Int                  @id @default(autoincrement())
  announcementId Int
  location       AnnouncementLocation
  /// Only meaningful for DEPARTMENT_PAGE - null means "all departments".
  departmentId   Int?
  sortOrder      Int                  @default(0)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  department   Department?  @relation("AnnouncementPlacement_Department", fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([announcementId, location, departmentId])
  @@index([location])
  @@index([departmentId])
}

/// In-App Notification Center (Premium UI Redesign) - the admin-facing bell
/// icon's real backing model, distinct from `Notification` (public-facing
/// scrolling ticker notices, unrelated). One row per (recipient admin,
/// event) - a "broadcast" event (e.g. a new career application, relevant to
/// every admin with career_applications.view) is materialized as N rows at
/// creation time (one per eligible admin) rather than a single shared row
/// with a nullable adminId, so each admin's isRead/readAt is genuinely
/// their own and never collides with another admin's read state. Correct
/// and simple at this project's scale (a handful of admins, not the kind of
/// fan-out volume that would need a separate read-state table).
enum AdminNotificationType {
  CAREER_APPLICATION_RECEIVED
  ANNOUNCEMENT_PUBLISHED
  ADMIN_CREATED
  GENERAL
}

model AdminNotification {
  id        Int                   @id @default(autoincrement())
  adminId   Int
  type      AdminNotificationType
  title     String
  message   String?
  /// Admin-relative path the "View" action navigates to, e.g.
  /// "/admin/careers/applications".
  link      String?
  isRead    Boolean               @default(false)
  readAt    DateTime?
  createdAt DateTime              @default(now())

  admin Admin @relation("AdminNotification_Admin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, isRead])
  @@index([adminId, createdAt])
}

/// Sprint "tonight" build - a campus events calendar, distinct from
/// `ExamNotification`/scrolling ticker notices (Notification model).
model Event {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  eventDate   DateTime
  endDate     DateTime?
  location    String?
  imageUrl    String?
  category    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as HomepageHero.mediaId /
  /// GalleryImage.mediaId / News.mediaId). imageUrl stays authoritative for
  /// existing rows and legacy manual-URL saves; when set, the server
  /// resolves this to the Media Library's current URL for that asset on
  /// every read/write so Replace propagates without an Events re-save.
  mediaId Int?
  /// Optional video and document attachments, alongside the image.
  videoUrl        String?
  videoMediaId    Int?
  documentUrl     String?
  documentMediaId Int?

  deletedByAdmin Admin? @relation("Event_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
  @@index([eventDate])
}

model Category {
  id        Int            @id @default(autoincrement())
  domain    CategoryDomain
  name      String
  slug      String
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  news              News[]             @relation("News_Category")
  galleryImages     GalleryImage[]     @relation("GalleryImage_Category")
  examNotifications ExamNotification[] @relation("ExamNotification_Category")
  downloads         Download[]         @relation("Download_Category")

  @@unique([domain, slug])
  @@index([domain])
}

model Download {
  id           Int              @id @default(autoincrement())
  title        String
  description  String?
  category     DownloadCategory
  departmentId Int?
  categoryId   Int?
  /// Optional page/section slug (e.g. "edc", "iic", "iqac", "alumni",
  /// "academics") that routes this document to a specific public page's
  /// "Downloads & Resources" block. Null = not tied to a page section
  /// (still appears in the general Downloads listing). Free string, driven
  /// by a known list in the admin UI (PAGE_SECTIONS) so new sections are
  /// added deliberately without a migration.
  pageSection  String?
  /// Optional free-text grouping heading a page renders documents under
  /// (e.g. "AY 2025-26" on Examinations, "B.Tech" / "M.Tech" / "MBA" on
  /// Syllabus). Null = ungrouped. PageResources groups by this verbatim.
  groupLabel   String?
  fileUrl      String
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  publishedAt  DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as the other modules' mediaId columns).
  /// fileUrl stays authoritative for existing rows and legacy manual-URL
  /// saves; when set, the server resolves this to the Media Library's
  /// current URL for that asset on every read/write so Replace propagates
  /// without a Downloads re-save.
  mediaId Int?

  department     Department? @relation("Download_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  categoryRef    Category?   @relation("Download_Category", fields: [categoryId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?      @relation("Download_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([category])
  @@index([deletedAt])
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String?

  roles RolePermission[]
}

model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions RolePermission[]
  admins      AdminRole[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminRole {
  adminId    Int
  roleId     Int
  assignedAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id          Int       @id @default(autoincrement())
  adminId     Int
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

/// Global, admin-editable site configuration - singular values only (main
/// phone/email, social links, logo, SEO defaults, footer tagline) instead of
/// hardcoded values scattered through the frontend. Repeating structures
/// (the multiple named office contacts found in the content audit) live in
/// ContactChannel instead - see that model's comment for the reasoning.
/// No soft-delete/versioning - this is system configuration, not "content"
/// in the sense the soft-delete policy covers; removing a setting just
/// falls back to a hardcoded default in code.
model SiteSetting {
  id          Int             @id @default(autoincrement())
  key         String          @unique
  value       String
  type        SiteSettingType
  group       String
  isPublic    Boolean         @default(false)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Addition beyond the requested field list, flagged for your review: an
  // accountability trail for who last changed a given setting.
  updatedBy Int?

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as the other modules' mediaId columns).
  /// Only meaningful when type is IMAGE_URL; `value` stays authoritative
  /// for existing rows and legacy manual-URL saves.
  mediaId Int?

  updatedByAdmin Admin? @relation("SiteSetting_UpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([group])
  @@index([isPublic])
}

// =============================================================================
// PAGE-DRIVEN CONTENT ENTITIES
//
// Added after a systematic audit of every frontend page (per the
// "design every module from the perspective of the website pages"
// instruction). Finding: outside of the homepage (data/home.ts) and
// department pages (data/departments/*.ts), essentially every page's
// content - hero banners, statistics, testimonials, videos, accreditation
// badges, recruiter logos, contact office details, leadership profiles -
// is hardcoded inline in the page.tsx file itself, requiring a developer
// to change it. These 10 tables give every one of those content types a
// real, admin-manageable home. See DATA_MODEL_DESIGN.md for the full
// per-entity rationale, including which duplicated/conflicting hardcoded
// values (e.g. two different pages currently claim "45+" vs "46+" years
// of institutional history) this is intended to consolidate.
//
// None of these are department-scoped (no evidence any of them need to
// vary per department) or given a `sortOrder`-independent unique key
// beyond what's noted per model. All are in the approved soft-delete +
// optimistic-locking scope, as an extension of "Department content"/
// "content" more broadly - a judgment call flagged for review, since none
// of these existed when the original soft-delete scope list was written.
// =============================================================================

/// Homepage CMS (Sprint 1A) - the full-screen video hero banner at the top
/// of the public homepage. A singleton (application code always reads/writes
/// id=1) rather than a page-keyed row like PageBanner, since the homepage
/// hero has fields (video, rotating captions, a news ticker, two CTAs) that
/// don't generalize to other pages the way PageBanner's simpler
/// title/subtitle/image shape does - see DATA_MODEL_DESIGN.md's homepage
/// research for the full content inventory this maps to.
model HomepageHero {
  id                 Int      @id @default(autoincrement())
  accreditationLabel String?
  heading            String
  subtitle           String
  /// Legacy hand-typed path/URL - stays authoritative for existing rows
  /// and as a fallback. New saves prefer mediaId; videoUrl is kept in sync
  /// with the Media Library's resolved URL when mediaId is set, so any
  /// code still reading videoUrl directly (or an old row with no mediaId)
  /// keeps working unchanged during the transition.
  videoUrl           String
  /// Media Library reference for the background video - plain Int, not a
  /// Prisma relation FK (Media stays decoupled from its 15+ future
  /// consumer tables the same way MediaUsage already is; referential
  /// integrity here is enforced in HeroService, not the DB schema).
  mediaId            Int?
  ctaPrimaryText     String?
  ctaPrimaryHref     String?
  ctaSecondaryText   String?
  ctaSecondaryHref   String?
  panelLabel         String?
  /// [{ "label": string, "text": string }, ...] - rotating caption strip
  /// inside the glass panel. Edited as a whole unit, not row-by-row, so a
  /// Json column is used instead of a child table (same reasoning as
  /// PageBanner.breadcrumbs below).
  captions           Json?
  /// [{ "isNew": boolean, "date": string, "text": string, "href": string | null }, ...]
  newsTicker         Json?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("HomepageHero_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Homepage CMS (Sprint 1B) - one row per fixed homepage section (vision,
/// mission, about, admissions this sprint). `key` is the stable identifier
/// the frontend/backend both key off; `content` is a Json blob whose shape
/// depends on `key` (validated per-key at the DTO layer, e.g. VisionContentDto
/// vs AboutContentDto - see src/homepage/sections/). One table instead of
/// one per section since every section shares the same envelope (status,
/// versioning, soft-delete) and only the payload shape differs, same
/// reasoning as HomepageHero.captions/newsTicker using Json over child
/// tables. `sortOrder` is reserved for Sprint 1C/1D's cross-section
/// drag-reorder once every homepage section (not just these 4) is under
/// management - not exposed in any Sprint 1B UI.
model HomepageSection {
  id        Int           @id @default(autoincrement())
  key       String        @unique
  content   Json
  status    SectionStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("HomepageSection_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([deletedAt])
}

/// One row per non-department page's hero banner AND SEO metadata combined
/// (a page has exactly one of each, so one table serves both rather than
/// two nearly-1:1 tables). Department pages keep using Department's own
/// heroImageUrl/metaTitle/etc. fields instead of this table.
model PageBanner {
  id              Int      @id @default(autoincrement())
  /// Free-text, unique key matching the frontend route it represents (e.g.
  /// "about", "contact", "naac"; NOT a DB enum - new pages are added to the
  /// frontend routinely and shouldn't require a migration to get a banner).
  pageKey         String   @unique
  title           String
  subtitle        String?
  eyebrow         String?
  imageUrl        String
  /// [{ "label": string, "href": string | null }, ...] - always edited as a
  /// whole unit per page, not independently CRUD'd row by row like
  /// LearningOutcome/DepartmentProgramme, so a Json column is used instead
  /// of a child table.
  breadcrumbs     Json?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("PageBanner_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Resolves a real data-quality bug found in the audit: the same figures
/// (years of institutional history, campus area, student count, department
/// count) are hardcoded independently on the homepage, About page, and
/// Alumni page, with DIFFERENT, CONFLICTING values on each (e.g. "45+" vs
/// "46+" years). One admin-editable source of truth per stat.
model SiteStatistic {
  id        Int      @id @default(autoincrement())
  /// Which page/section this stat belongs to (e.g. "homepage", "about",
  /// "alumni") - a lightweight grouping tag, not a full Category relation,
  /// since these groupings are page-specific rather than a shared taxonomy.
  scope     String
  label     String
  value     Int
  suffix    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Department CMS phase - optional so this table keeps serving global
  /// homepage/page statistics (departmentId: null) as well as
  /// per-department stat cards, one reusable model instead of two.
  departmentId Int?

  deletedByAdmin Admin?      @relation("SiteStatistic_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  departmentRef  Department? @relation("SiteStatistic_Department", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([deletedAt])
}

/// The contact page's multiple named office contacts (Principal, Admissions,
/// Examination Cell, Placement Office, Main Office), each independently
/// hardcoded today - a repeating structure, unlike SiteSetting's singular
/// values, which is why this is its own table rather than more
/// awkwardly-named SiteSetting keys.
model ContactChannel {
  id          Int      @id @default(autoincrement())
  name        String
  phones      String[]
  emails      String[]
  address     String?
  mapEmbedUrl String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Department CMS phase - optional so this table keeps serving the
  /// global office directory (Principal/Admissions/Exam/Placement/Main,
  /// departmentId: null) as well as per-department contact info, one
  /// reusable model instead of two.
  departmentId Int?

  /// Only meaningful for the global directory (departmentId: null), where the
  /// public Contact page renders two visually different blocks from the same
  /// table: "info" is the single-fact icon row (Address/Phone/Email at the top
  /// of the page - one of address/phones/emails is set per row), "directory"
  /// is the office card grid (Principal/Admissions/Exam/Placement - name plus
  /// its own phones/emails/address). A department's own Contact tab ignores
  /// this and always renders as one directory-style grid, so it is left at its
  /// default there rather than exposed as a choice with only one right answer.
  group String @default("directory")

  deletedByAdmin Admin?      @relation("ContactChannel_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  departmentRef  Department? @relation("ContactChannel_Department", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
  @@index([departmentId])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  company   String?
  quote     String
  /// 1-5. Not enforced by a CHECK constraint in Phase 1 (Prisma's schema DSL
  /// doesn't express one directly) - validate at the application layer.
  rating    Int
  photoUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as the other modules' mediaId columns).
  /// photoUrl stays authoritative for existing rows and legacy manual-URL
  /// saves.
  mediaId Int?

  deletedByAdmin Admin? @relation("Testimonial_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

model CampusVideo {
  id         Int      @id @default(autoincrement())
  title      String
  youtubeUrl String
  /// Nullable - the public component falls back to a generic "Campus Video"
  /// label when unset. Replaces the previous by-array-position badge text,
  /// which silently mislabeled videos whenever they were reordered.
  badgeLabel String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Department CMS phase - optional so this table keeps serving the
  /// homepage's global Campus Videos section (departmentId: null) as well
  /// as per-department Videos sections, one reusable model instead of two.
  departmentId Int?

  deletedByAdmin Admin?      @relation("CampusVideo_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  departmentRef  Department? @relation("CampusVideo_Department", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
  @@index([departmentId])
}

model AccreditationBadge {
  id        Int      @id @default(autoincrement())
  shortName String
  grade     String?
  name      String
  subtext   String?
  linkUrl   String?
  linkText  String?
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as the other modules' mediaId columns).
  /// imageUrl stays authoritative for existing rows and legacy manual-URL
  /// saves. Added after the Homepage Reliability audit found this was the
  /// one homepage-image module never wired to the Media Library, so its
  /// logos had no Replace/Version History support at all.
  mediaId Int?

  deletedByAdmin Admin? @relation("AccreditationBadge_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Company logos for the placements marquee - distinct from the Placement
/// model (which records individual student placements): this is purely
/// "logos of companies that recruit here" for marketing display.
model Recruiter {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as the other modules' mediaId columns).
  /// logoUrl stays authoritative for existing rows and legacy manual-URL
  /// saves.
  mediaId Int?

  deletedByAdmin Admin? @relation("Recruiter_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// No FAQ pattern exists anywhere on the site today (confirmed by the audit)
/// - seeded proactively per the "if a page has FAQs, the CMS should manage
/// them" instruction, ready for whenever one is built.
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  /// Nullable - null means a general/global FAQ not tied to one page.
  pageKey   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Faq_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([pageKey])
  @@index([isActive])
  @@index([deletedAt])
}

/// Institutional leadership (Chairman, Secretary cum Correspondent, Vice
/// Chairman & MD, Principal) - the About page's leadership cards plus their
/// individual /about/[slug] detail pages, currently hardcoded per-person in
/// the frontend with `generateStaticParams`.
model LeadershipProfile {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  role      String
  photoUrl  String
  email     String?
  shortBio  String?
  longBio   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("LeadershipProfile_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Deliberately generic, unlike every other model in this schema: covers
/// the long tail of one-off card/list patterns found in the audit (homepage
/// service cards, admission program highlight cards, IIC/EDC/RDC/Careers
/// objective-and-icon lists) that don't individually justify a dedicated
/// table. `section` is a namespaced convention key (e.g.
/// "homepage.services", "iic.objectives") coordinated between admins and
/// developers, not a DB-enforced taxonomy - a deliberate flexibility/
/// type-safety tradeoff flagged for review; if any one `section` grows a
/// genuinely distinct required shape, it should graduate to its own table.
model ContentCard {
  id          Int      @id @default(autoincrement())
  section     String
  icon        String?
  imageUrl    String?
  title       String?
  description String?
  /// e.g. branch-code pills on the homepage's admission program cards.
  tags        String[]
  linkUrl     String?
  linkText    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  /// Media Library reference (plain Int, no Prisma relation - same
  /// decoupled-by-design reasoning as the other modules' mediaId columns).
  /// imageUrl stays authoritative for existing rows and legacy manual-URL
  /// saves. Shared across every ContentCard-backed section (Quick Links,
  /// Admission Programs, Accreditation Badges, homepage Departments teaser)
  /// via ContentCardService, so wiring it once here covers all of them.
  mediaId Int?

  deletedByAdmin Admin? @relation("ContentCard_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([section])
  @@index([isActive])
  @@index([deletedAt])
}

// -----------------------------------------------------------------------------
// Media Library - centralized upload/asset management. See
// backend/src/media/README.md for the full design writeup. Every module that
// currently stores a hand-typed imageUrl/fileUrl string is expected to adopt
// this by referencing Media.id instead, one module at a time in future
// passes - nothing is migrated to use it yet.
// -----------------------------------------------------------------------------

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

/// PENDING/PROCESSING exist for both the async image-variant pipeline (used
/// this pass) and the future video-transcoding pipeline (not built yet, but
/// won't need another migration when it lands).
enum MediaProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// ORIGINAL/SOURCE is a re-encoded, EXIF-stripped rendition - the raw upload
/// (Media.storageKey) is archival only and never served publicly. CROP rows
/// are on-demand, admin-triggered (see MediaVariant.cropPreset below).
enum MediaVariantSize {
  ORIGINAL
  HERO
  LARGE
  MEDIUM
  SMALL
  THUMBNAIL
  CROP
}

enum MediaVariantFormat {
  SOURCE
  WEBP
}

/// Simple self-referencing tree, e.g. "Departments" -> "CSE". `path` is
/// materialized (slash-joined ancestor names) so breadcrumbs/lookups don't
/// need a recursive query. Deliberately NOT type-gated (an Image and a
/// Video can share a folder) - see schema design notes.
model MediaFolder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MediaFolder?  @relation("MediaFolder_Children", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("MediaFolder_Children")
  media    Media[]

  @@unique([parentId, name])
  @@index([path])
}

model Media {
  id               Int       @id @default(autoincrement())
  type             MediaType
  originalFilename String
  /// Adapter-relative key for the archival original (e.g.
  /// "media/2026/07/<uuid>.jpg"). Never exposed as a public URL directly -
  /// public access always goes through a MediaVariant via mediaId.
  storageKey       String
  mimeType         String
  extension        String
  /// BigInt: Int32 tops out at ~2.1GB, right at this module's 2GB video
  /// ceiling. See backend/src/main.ts for the required BigInt JSON shim.
  sizeBytes        BigInt
  checksumSha256   String    @unique

  width  Int?
  height Int?

  // --- reserved for the next-pass video transcoding pipeline; unused by
  // anything this pass writes, kept here so that pass is additive ---
  durationSeconds Float?
  codec           String?
  bitrateKbps     Int?

  processingStatus MediaProcessingStatus @default(PENDING)
  processingError  String?

  title        String?
  altText      String?
  caption      String?
  description  String?
  copyright    String?
  photographer String?

  folderId Int?
  category String?
  /// Doubles as the SEO "Keywords" field the metadata panel exposes - kept
  /// as one array rather than a second, functionally-duplicate column.
  tags     String[]

  uploadedByAdminId Int?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  folder          MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedByAdmin Admin?       @relation("Media_UploadedBy", fields: [uploadedByAdminId], references: [id], onDelete: SetNull)
  deletedByAdmin  Admin?       @relation("Media_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  variants MediaVariant[]
  usages   MediaUsage[]
  versions MediaVersion[]

  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
  @@index([folderId])
  @@index([category])
  @@index([processingStatus])
}

/// One row per (size, format) rendition. Images get up to 12 (6 sizes x
/// SOURCE/WEBP) once processing completes; video/document get exactly one
/// (ORIGINAL/SOURCE) this pass. CROP rows are added on demand, one per
/// distinct cropPreset - re-cropping the same preset replaces its row
/// rather than stacking duplicates (see the unique constraint).
model MediaVariant {
  id         Int                @id @default(autoincrement())
  mediaId    Int
  variant    MediaVariantSize
  format     MediaVariantFormat
  storageKey String
  width      Int?
  height     Int?
  sizeBytes  BigInt
  createdAt  DateTime           @default(now())

  /// Set only on CROP rows - the preset key (e.g. "HERO_BANNER") and the
  /// source-image pixel rectangle that was cropped, so it can be
  /// re-adjusted later without starting over.
  cropPreset  String?
  sourceCropX Int?
  sourceCropY Int?
  sourceCropW Int?
  sourceCropH Int?

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, variant, format, cropPreset])
  @@index([mediaId])
}

/// Generic, decoupled usage-tracking pointer - deliberately NOT an FK into
/// any consumer table (Media can't polymorphically reference 15 different
/// content models). Same loose module/targetId string-keyed shape
/// AuditLog already uses. Zero rows are ever written by this pass - every
/// future module adopts tracking itself when it migrates off its string
/// URL field.
model MediaUsage {
  id        Int      @id @default(autoincrement())
  mediaId   Int
  module    String
  recordId  Int
  field     String
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, module, recordId, field])
  @@index([mediaId])
  @@index([module, recordId])
}

/// Snapshot of Media's previous live state, written on every Replace
/// (including a rollback itself, which is just another append - history
/// is never rewritten).
model MediaVersion {
  id                Int      @id @default(autoincrement())
  mediaId           Int
  versionNumber     Int
  storageKey        String
  mimeType          String
  sizeBytes         BigInt
  checksumSha256    String
  width             Int?
  height            Int?
  replacedByAdminId Int?
  createdAt         DateTime @default(now())

  media           Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  replacedByAdmin Admin? @relation("MediaVersion_ReplacedBy", fields: [replacedByAdminId], references: [id], onDelete: SetNull)

  @@unique([mediaId, versionNumber])
  @@index([mediaId])
}

/// An editable table of text on a public page - fee structures, courses &
/// intake, admissions details. These were hardcoded arrays in the page files,
/// so a yearly fee revision needed a code change. Columns/rows are free-form
/// (String[] / Json) rather than a fixed shape, because the tables differ per
/// page and new ones must not need a migration. A page renders its CMS table
/// when one exists and falls back to its built-in list otherwise.
model PageTable {
  id          Int      @id @default(autoincrement())
  /// Stable identifier the page looks itself up by, e.g. "fee.btech-first-year".
  key         String   @unique
  /// PAGE_SECTIONS value this table belongs to, e.g. "academics.fee-structure".
  pageSection String
  title       String
  /// Column headings, in order.
  columns     String[]
  /// Row cells: an array of string arrays, aligned to `columns`.
  rows        Json
  /// Optional note rendered under the table (e.g. "Fees revised annually").
  footnote    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  version     Int      @default(1)

  @@index([pageSection])
  @@index([isActive])
}

/// An admin's replacement for a piece of a page's built-in text.
///
/// Pages keep their wording in code (see frontend/lib/page-text-registry.ts),
/// which is what the static export ships and what search engines index. A row
/// here overrides one of those slots at runtime. No row means "use the page's
/// own text", so deleting a row is the natural undo - which is why this model
/// has no isActive or soft-delete columns, unlike the content modules.
model PageText {
  id          Int      @id @default(autoincrement())
  /// Slot identifier from the frontend registry, e.g. "library.about.p1".
  key         String   @unique
  /// PAGE_SECTIONS value the slot belongs to, e.g. "library". Indexed because
  /// a page fetches its overrides by section in one request.
  pageSection String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  version     Int      @default(1)

  @@index([pageSection])
}

/// A college bus route, with its timings, fee and the crew who run it.
///
/// The transport page listed eight routes as a hardcoded array; the wording of
/// each was editable through page-text slots, but a route could not be added,
/// removed or reordered without a code change - and the fleet changes every
/// year. Same shape as ContactChannel: a repeating public record with its own
/// admin screen, soft-delete and optimistic locking.
model TransportRoute {
  id       Int    @id @default(autoincrement())
  /// Route number as displayed, e.g. "R1". Free text, not an integer - some
  /// colleges use "A1" or "N-2".
  routeNo  String
  /// Where the route starts from.
  fromPlace String
  /// The stops in between, as one line: "Clock Tower -> Tirupati Road -> Gate".
  via      String?
  /// Departure and return times, kept as free text so "6:45 AM" and
  /// "6:45 AM (Sat 7:15)" are both expressible without a schema change.
  departTime String?
  returnTime String?
  /// Monthly fee as displayed, e.g. "Rs 3,000/month".
  fee      String?
  /// The bus and its crew. All optional - a route can be published before the
  /// driver is assigned for the year.
  busNo       String?
  driverName  String?
  driverPhone String?

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("TransportRoute_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([sortOrder])
}

/// What kind of exam record this is.
///
/// The Examinations page has always shown these as separate lists, but they
/// were fed from Downloads with a page-section slug - so publishing a result
/// meant going to Documents, picking the right section, and then writing a
/// notice separately. One screen, one dropdown, and the page sorts itself.
enum ExamNotificationType {
  NOTIFICATION
  RESULT
  TIMETABLE
  QUESTION_PAPER
  SYLLABUS
  CALENDAR
}
