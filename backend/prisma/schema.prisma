generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// PHASE 1 - ADDITIVE ONLY
//
// Every model below that existed before this migration keeps every one of its
// existing fields, with the exact same name/type/nullability/default it had
// before. New fields on existing models are grouped under a clearly marked
// "Phase 1 additive fields" comment. No existing column is renamed, retyped,
// or dropped. No data is backfilled by this migration - new FK/lookup columns
// are nullable and unpopulated until a later, separate migration.
//
// See backend/DATA_MODEL_DESIGN.md for the full design rationale, the
// migration phase plan, and the list of items explicitly deferred out of
// Phase 1 (§5.5: Notification -> TickerNotice rename; Research.type /
// DegreeVerification.degree / AuditLog.action enum conversions;
// AuditLog.adminId FK constraint; RBAC assignment to existing admins).
// =============================================================================

// -----------------------------------------------------------------------------
// ENUMS (all new - none of these existed before Phase 1)
// -----------------------------------------------------------------------------

enum OutcomeType {
  PEO
  PO
  PSO
}

enum ProgrammeLevel {
  UG
  PG
  PHD
  DIPLOMA
}

/// Restricted to committees that actually exist on the current site today
/// (Anti-Ragging, Grievance Redressal). OTHER is the escape hatch for a
/// future committee rather than a speculative pre-seeded type - no
/// Women's-Cell/SC-ST-Cell values are included since no such page/content
/// exists yet (per explicit instruction: don't invent future committee data).
enum CommitteeType {
  ANTI_RAGGING
  GRIEVANCE_REDRESSAL
  OTHER
}

enum CategoryDomain {
  NEWS
  GALLERY
  EXAM_NOTIFICATION
  DOWNLOAD
}

enum DownloadCategory {
  SYLLABUS
  QUESTION_PAPER
  BROCHURE
  AFFIDAVIT
  FORM
  OTHER
}

/// Value-type hint for SiteSetting.value, so the admin UI knows how to
/// render/validate a setting without special-casing every key by name.
enum SiteSettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  URL
  EMAIL
  IMAGE_URL
}

/// Homepage CMS (Sprint 1B). Deliberately just 2 values for now - SCHEDULED
/// is added later (Sprint 1D) alongside real publishAt/expiresAt evaluation
/// logic; Postgres enums extend additively so reserving the value now isn't
/// needed and would just be dead until 1D wires it up. The admin UI's status
/// badge already color-codes for a future "Scheduled" state, it just can't
/// be reached yet.
enum SectionStatus {
  DRAFT
  PUBLISHED
}

// -----------------------------------------------------------------------------
// EXISTING MODELS - untouched original fields, additive columns only
// -----------------------------------------------------------------------------

model Notification {
  id        Int      @id @default(autoincrement())
  text      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Phase 1 additive fields ---
  // NOTE: approved to be renamed to `TickerNotice` in a later phase via an
  // explicit `ALTER TABLE ... RENAME TO ...` migration (hand-written, not a
  // naive Prisma schema diff, which would DROP+CREATE and destroy data).
  // Left as `Notification` here on purpose - see DATA_MODEL_DESIGN.md §5.5.
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)

  @@index([isActive])
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String
  imageUrl    String?
  date        DateTime
  isPublished Boolean  @default(true)
  /// Sprint 1C - lets the homepage's Latest News section prioritize
  /// hand-picked stories instead of always showing just the N most recent.
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Phase 1 additive fields ---
  slug          String?   @unique
  categoryId    Int?
  authorAdminId Int?
  deletedAt     DateTime?
  deletedBy     Int?
  version       Int       @default(1)

  categoryRef    Category? @relation("News_Category", fields: [categoryId], references: [id], onDelete: SetNull)
  authorAdmin    Admin?    @relation("News_Author", fields: [authorAdminId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?    @relation("News_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([authorAdminId])
  @@index([deletedAt])
}

model Faculty {
  id             Int      @id @default(autoincrement())
  name           String
  designation    String
  qualification  String
  department     String
  specialization String?
  experience     String?
  email          String?
  photoUrl       String?
  isHod          Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // --- Phase 1 additive fields ---
  departmentId   Int?
  welcomeMessage String?
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  deletedBy      Int?
  version        Int       @default(1)

  departmentRef        Department?       @relation("Faculty_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  hodOfDepartment      Department?       @relation("Department_Hod")
  deletedByAdmin       Admin?            @relation("Faculty_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  labsInCharge         Lab[]             @relation("Lab_InCharge")
  committeeMemberships CommitteeMember[] @relation("CommitteeMember_Faculty")

  @@index([departmentId])
  @@index([isActive])
  @@index([deletedAt])
}

model Placement {
  id          Int      @id @default(autoincrement())
  studentName String
  company     String
  package     String
  department  String
  year        Int
  imageUrl    String?
  createdAt   DateTime @default(now())

  // --- Phase 1 additive fields ---
  departmentId   Int?
  companyLogoUrl String?
  isPublished    Boolean   @default(true)
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?
  deletedBy      Int?
  version        Int       @default(1)

  departmentRef  Department? @relation("Placement_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?      @relation("Placement_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([deletedAt])
}

model GalleryImage {
  id        Int       @id @default(autoincrement())
  title     String
  imageUrl  String
  category  String
  date      DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  // --- Phase 1 additive fields ---
  categoryId   Int?
  departmentId Int?
  sortOrder    Int       @default(0)
  deletedAt    DateTime?
  deletedBy    Int?
  version      Int       @default(1)

  categoryRef    Category?   @relation("GalleryImage_Category", fields: [categoryId], references: [id], onDelete: SetNull)
  departmentRef  Department? @relation("GalleryImage_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?      @relation("GalleryImage_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([departmentId])
  @@index([deletedAt])
}

model DegreeVerification {
  id            Int      @id @default(autoincrement())
  studentName   String
  hallTicketNo  String   @unique
  department    String
  yearOfPassing Int
  degree        String
  isVerified    Boolean  @default(true)
  createdAt     DateTime @default(now())

  // --- Phase 1 additive fields ---
  departmentId     Int?
  cgpaOrPercentage Decimal? @db.Decimal(5, 2)
  updatedAt        DateTime @default(now()) @updatedAt

  departmentRef Department? @relation("DegreeVerification_Department", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([departmentId])
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  isSuperAdmin Boolean  @default(false)
  permissions  String[] // "faculty", "news", "gallery", "placements", "exam", "notifications", "research", "degree_verification", "admins"
  department   String? // optional, for faculty management
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Phase 1 additive fields ---
  // NOTE: `permissions` (above) stays untouched in Phase 1. Roles are seeded
  // (see prisma/seed.ts) but NOT yet assigned to any existing admin - that
  // assignment is an explicit, separate, reviewed data migration (see
  // DATA_MODEL_DESIGN.md §9 Phase 5), not part of this additive migration.
  departmentId Int?
  lastLoginAt  DateTime?

  departmentRef Department? @relation("Admin_Department", fields: [departmentId], references: [id], onDelete: SetNull)

  roles         AdminRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  authoredNews News[] @relation("News_Author")

  // Reverse side of every `deletedBy` FK across the schema - see
  // DATA_MODEL_DESIGN.md §5 for the soft-delete matrix these correspond to.
  deletedNews                 News[]                @relation("News_DeletedBy")
  deletedFaculty              Faculty[]             @relation("Faculty_DeletedBy")
  deletedPlacements           Placement[]           @relation("Placement_DeletedBy")
  deletedGalleryImages        GalleryImage[]        @relation("GalleryImage_DeletedBy")
  deletedLabs                 Lab[]                 @relation("Lab_DeletedBy")
  deletedDepartments          Department[]          @relation("Department_DeletedBy")
  deletedLearningOutcomes     LearningOutcome[]     @relation("LearningOutcome_DeletedBy")
  deletedDepartmentProgrammes DepartmentProgramme[] @relation("DepartmentProgramme_DeletedBy")
  deletedDepartmentHighlights DepartmentHighlight[] @relation("DepartmentHighlight_DeletedBy")
  deletedDownloads            Download[]            @relation("Download_DeletedBy")
  deletedCommittees           Committee[]           @relation("Committee_DeletedBy")
  deletedCommitteeMembers     CommitteeMember[]     @relation("CommitteeMember_DeletedBy")
  updatedSiteSettings         SiteSetting[]         @relation("SiteSetting_UpdatedBy")

  // Reverse side of the page-driven content entities added after the
  // frontend content audit (see DATA_MODEL_DESIGN.md's Page-Driven Content
  // Entities section).
  deletedPageBanners         PageBanner[]         @relation("PageBanner_DeletedBy")
  deletedSiteStatistics      SiteStatistic[]      @relation("SiteStatistic_DeletedBy")
  deletedContactChannels     ContactChannel[]     @relation("ContactChannel_DeletedBy")
  deletedTestimonials        Testimonial[]        @relation("Testimonial_DeletedBy")
  deletedCampusVideos        CampusVideo[]        @relation("CampusVideo_DeletedBy")
  deletedAccreditationBadges AccreditationBadge[] @relation("AccreditationBadge_DeletedBy")
  deletedRecruiters          Recruiter[]          @relation("Recruiter_DeletedBy")
  deletedFaqs                Faq[]                @relation("Faq_DeletedBy")
  deletedLeadershipProfiles  LeadershipProfile[]  @relation("LeadershipProfile_DeletedBy")
  deletedContentCards        ContentCard[]        @relation("ContentCard_DeletedBy")

  // Homepage CMS (Sprint 1A).
  deletedHomepageHeroes HomepageHero[] @relation("HomepageHero_DeletedBy")

  // Homepage CMS (Sprint 1B).
  deletedHomepageSections HomepageSection[] @relation("HomepageSection_DeletedBy")

  // New content modules (Careers, Events).
  deletedCareers Career[] @relation("Career_DeletedBy")
  deletedEvents  Event[]  @relation("Event_DeletedBy")

  @@index([departmentId])
}

model Research {
  id         Int      @id @default(autoincrement())
  title      String
  authors    String
  journal    String?
  year       Int
  department String
  type       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // --- Phase 1 additive fields ---
  // NOTE: `type` (above) is NOT converted to the planned `ResearchType` enum
  // in Phase 1 - see DATA_MODEL_DESIGN.md §5.5 (deferred, same reasoning as
  // the other existing-column type changes). Research is also intentionally
  // NOT given soft-delete columns - it wasn't in the approved soft-delete
  // scope list (Faculty/Labs/News/Gallery/Downloads/Placements/Committees/
  // Department content); `isActive` already serves as its hide/show toggle.
  departmentId Int?
  doiOrLink    String?
  updatedAt    DateTime @default(now()) @updatedAt

  departmentRef Department? @relation("Research_Department", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([year])
}

model ExamNotification {
  id        Int      @id @default(autoincrement())
  title     String
  fileUrl   String?
  category  String
  date      DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // --- Phase 1 additive fields ---
  // NOTE: also intentionally not given soft-delete columns - same reasoning
  // as Research (not in the approved soft-delete scope list).
  categoryId   Int?
  departmentId Int?
  updatedAt    DateTime @default(now()) @updatedAt

  categoryRef   Category?   @relation("ExamNotification_Category", fields: [categoryId], references: [id], onDelete: SetNull)
  departmentRef Department? @relation("ExamNotification_Department", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([departmentId])
}

// Audit Log for tracking admin actions
model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  adminName  String
  adminEmail String
  action     String // "CREATE" | "UPDATE" | "DELETE"
  module     String // "faculty" | "news" | "gallery" | "placements" | "exam" | "notifications" | "degree_verification"
  targetId   Int? // ID of the affected record
  details    String? // JSON string with changes
  ipAddress  String? // IP address of the admin
  createdAt  DateTime @default(now())

  // --- Phase 1 additive fields ---
  // NOTE: `adminId` (above) does NOT get an FK constraint added in Phase 1.
  // Adding one now would require every existing AuditLog.adminId value to
  // already reference a real Admin.id, which hasn't been verified against
  // live data - a constraint that could fail partway through applying is
  // exactly the kind of risk Phase 1 is designed to avoid. The real FK
  // (`adminRef`, nullable, SetNull) is added here as a NEW, separate,
  // unenforced-until-backfilled column; the plain `adminId` Int stays
  // exactly as it was. See DATA_MODEL_DESIGN.md §5.5 and §9 Phase 4.
  // `action` also stays a free String in Phase 1 for the same reason - the
  // AuditAction enum conversion is deferred alongside it.
  adminRefId Int?

  // Homepage CMS (Sprint 1A) - the correlation ID from the existing
  // request-id middleware (see common/middleware/request-id.middleware.ts),
  // so a single HTTP request's audit entries can be traced back to the
  // request that produced them. Nullable/additive: existing audit rows
  // predate this middleware and never had a request ID to record.
  requestId String?

  adminRef Admin? @relation(fields: [adminRefId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([module])
  @@index([createdAt])
  @@index([module, createdAt])
  @@index([adminRefId])
}

// -----------------------------------------------------------------------------
// NEW MODELS
// -----------------------------------------------------------------------------

model Department {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  shortName       String?
  tagline         String?
  intro           String?
  about           String
  aboutVideoUrl   String?
  heroImageUrl    String?
  vision          String?
  mission         String[]
  establishedYear Int?
  hodId           Int?     @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Added after the frontend content audit: department pages, like almost
  // every other page on the site, currently inherit only the root layout's
  // title/description with no per-page override.
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  // Soft delete + optimistic locking - "Department content" is explicitly
  // in the approved soft-delete scope.
  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  hod            Faculty? @relation("Department_Hod", fields: [hodId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?   @relation("Department_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  faculties           Faculty[]             @relation("Faculty_Department")
  labs                Lab[]                 @relation("Lab_Department")
  researches          Research[]            @relation("Research_Department")
  placements          Placement[]           @relation("Placement_Department")
  degreeVerifications DegreeVerification[]  @relation("DegreeVerification_Department")
  learningOutcomes    LearningOutcome[]     @relation("LearningOutcome_Department")
  programmes          DepartmentProgramme[] @relation("DepartmentProgramme_Department")
  highlights          DepartmentHighlight[] @relation("DepartmentHighlight_Department")
  galleryImages       GalleryImage[]        @relation("GalleryImage_Department")
  examNotifications   ExamNotification[]    @relation("ExamNotification_Department")
  downloads           Download[]            @relation("Download_Department")
  admins              Admin[]               @relation("Admin_Department")

  @@index([isActive])
  @@index([deletedAt])
}

model LearningOutcome {
  id           Int         @id @default(autoincrement())
  departmentId Int
  type         OutcomeType
  code         String
  title        String?
  text         String
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  department     Department @relation("LearningOutcome_Department", fields: [departmentId], references: [id], onDelete: Cascade)
  deletedByAdmin Admin?     @relation("LearningOutcome_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@unique([departmentId, type, code])
  @@index([departmentId, type])
  @@index([deletedAt])
}

model DepartmentProgramme {
  id           Int            @id @default(autoincrement())
  departmentId Int
  name         String
  level        ProgrammeLevel
  intake       Int
  sortOrder    Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  department     Department @relation("DepartmentProgramme_Department", fields: [departmentId], references: [id], onDelete: Cascade)
  deletedByAdmin Admin?     @relation("DepartmentProgramme_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([deletedAt])
}

model DepartmentHighlight {
  id           Int      @id @default(autoincrement())
  departmentId Int
  title        String
  description  String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  department     Department @relation("DepartmentHighlight_Department", fields: [departmentId], references: [id], onDelete: Cascade)
  deletedByAdmin Admin?     @relation("DepartmentHighlight_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([deletedAt])
}

model Lab {
  id                Int      @id @default(autoincrement())
  departmentId      Int
  name              String
  description       String
  imageUrl          String?
  capacity          Int?
  inChargeFacultyId Int?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  department      Department @relation("Lab_Department", fields: [departmentId], references: [id], onDelete: Cascade)
  inChargeFaculty Faculty?   @relation("Lab_InCharge", fields: [inChargeFacultyId], references: [id], onDelete: SetNull)
  deletedByAdmin  Admin?     @relation("Lab_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([inChargeFacultyId])
  @@index([deletedAt])
}

model Committee {
  id          Int           @id @default(autoincrement())
  name        String
  type        CommitteeType
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Committee_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  members CommitteeMember[] @relation("CommitteeMember_Committee")

  @@unique([type, name])
  @@index([deletedAt])
}

model CommitteeMember {
  id          Int      @id @default(autoincrement())
  committeeId Int
  facultyId   Int?
  name        String
  designation String
  role        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  committee      Committee @relation("CommitteeMember_Committee", fields: [committeeId], references: [id], onDelete: Cascade)
  faculty        Faculty?  @relation("CommitteeMember_Faculty", fields: [facultyId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?    @relation("CommitteeMember_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([committeeId])
  @@index([facultyId])
  @@index([deletedAt])
}

/// Sprint "tonight" build - job openings shown on the public Careers page.
/// `employmentType` kept as a plain string (not an enum) for build speed;
/// tighten to an enum later if the values need real validation.
model Career {
  id             Int       @id @default(autoincrement())
  title          String
  department     String?
  employmentType String?
  location       String?
  description    String
  applyUrl       String?
  applyEmail     String?
  postedAt       DateTime  @default(now())
  closingAt      DateTime?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Career_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Sprint "tonight" build - a campus events calendar, distinct from
/// `ExamNotification`/scrolling ticker notices (Notification model).
model Event {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  eventDate   DateTime
  endDate     DateTime?
  location    String?
  imageUrl    String?
  category    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Event_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
  @@index([eventDate])
}

model Category {
  id        Int            @id @default(autoincrement())
  domain    CategoryDomain
  name      String
  slug      String
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  news              News[]             @relation("News_Category")
  galleryImages     GalleryImage[]     @relation("GalleryImage_Category")
  examNotifications ExamNotification[] @relation("ExamNotification_Category")
  downloads         Download[]         @relation("Download_Category")

  @@unique([domain, slug])
  @@index([domain])
}

model Download {
  id           Int              @id @default(autoincrement())
  title        String
  description  String?
  category     DownloadCategory
  departmentId Int?
  categoryId   Int?
  fileUrl      String
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  publishedAt  DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  department     Department? @relation("Download_Department", fields: [departmentId], references: [id], onDelete: SetNull)
  categoryRef    Category?   @relation("Download_Category", fields: [categoryId], references: [id], onDelete: SetNull)
  deletedByAdmin Admin?      @relation("Download_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([category])
  @@index([deletedAt])
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String?

  roles RolePermission[]
}

model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions RolePermission[]
  admins      AdminRole[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminRole {
  adminId    Int
  roleId     Int
  assignedAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id          Int       @id @default(autoincrement())
  adminId     Int
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

/// Global, admin-editable site configuration - singular values only (main
/// phone/email, social links, logo, SEO defaults, footer tagline) instead of
/// hardcoded values scattered through the frontend. Repeating structures
/// (the multiple named office contacts found in the content audit) live in
/// ContactChannel instead - see that model's comment for the reasoning.
/// No soft-delete/versioning - this is system configuration, not "content"
/// in the sense the soft-delete policy covers; removing a setting just
/// falls back to a hardcoded default in code.
model SiteSetting {
  id          Int             @id @default(autoincrement())
  key         String          @unique
  value       String
  type        SiteSettingType
  group       String
  isPublic    Boolean         @default(false)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Addition beyond the requested field list, flagged for your review: an
  // accountability trail for who last changed a given setting.
  updatedBy Int?

  updatedByAdmin Admin? @relation("SiteSetting_UpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([group])
  @@index([isPublic])
}

// =============================================================================
// PAGE-DRIVEN CONTENT ENTITIES
//
// Added after a systematic audit of every frontend page (per the
// "design every module from the perspective of the website pages"
// instruction). Finding: outside of the homepage (data/home.ts) and
// department pages (data/departments/*.ts), essentially every page's
// content - hero banners, statistics, testimonials, videos, accreditation
// badges, recruiter logos, contact office details, leadership profiles -
// is hardcoded inline in the page.tsx file itself, requiring a developer
// to change it. These 10 tables give every one of those content types a
// real, admin-manageable home. See DATA_MODEL_DESIGN.md for the full
// per-entity rationale, including which duplicated/conflicting hardcoded
// values (e.g. two different pages currently claim "45+" vs "46+" years
// of institutional history) this is intended to consolidate.
//
// None of these are department-scoped (no evidence any of them need to
// vary per department) or given a `sortOrder`-independent unique key
// beyond what's noted per model. All are in the approved soft-delete +
// optimistic-locking scope, as an extension of "Department content"/
// "content" more broadly - a judgment call flagged for review, since none
// of these existed when the original soft-delete scope list was written.
// =============================================================================

/// Homepage CMS (Sprint 1A) - the full-screen video hero banner at the top
/// of the public homepage. A singleton (application code always reads/writes
/// id=1) rather than a page-keyed row like PageBanner, since the homepage
/// hero has fields (video, rotating captions, a news ticker, two CTAs) that
/// don't generalize to other pages the way PageBanner's simpler
/// title/subtitle/image shape does - see DATA_MODEL_DESIGN.md's homepage
/// research for the full content inventory this maps to.
model HomepageHero {
  id                 Int     @id @default(autoincrement())
  accreditationLabel String?
  heading            String
  subtitle           String
  videoUrl           String
  ctaPrimaryText     String?
  ctaPrimaryHref     String?
  ctaSecondaryText   String?
  ctaSecondaryHref   String?
  panelLabel         String?
  /// [{ "label": string, "text": string }, ...] - rotating caption strip
  /// inside the glass panel. Edited as a whole unit, not row-by-row, so a
  /// Json column is used instead of a child table (same reasoning as
  /// PageBanner.breadcrumbs below).
  captions           Json?
  /// [{ "isNew": boolean, "date": string, "text": string, "href": string | null }, ...]
  newsTicker         Json?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("HomepageHero_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Homepage CMS (Sprint 1B) - one row per fixed homepage section (vision,
/// mission, about, admissions this sprint). `key` is the stable identifier
/// the frontend/backend both key off; `content` is a Json blob whose shape
/// depends on `key` (validated per-key at the DTO layer, e.g. VisionContentDto
/// vs AboutContentDto - see src/homepage/sections/). One table instead of
/// one per section since every section shares the same envelope (status,
/// versioning, soft-delete) and only the payload shape differs, same
/// reasoning as HomepageHero.captions/newsTicker using Json over child
/// tables. `sortOrder` is reserved for Sprint 1C/1D's cross-section
/// drag-reorder once every homepage section (not just these 4) is under
/// management - not exposed in any Sprint 1B UI.
model HomepageSection {
  id        Int           @id @default(autoincrement())
  key       String        @unique
  content   Json
  status    SectionStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("HomepageSection_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([deletedAt])
}

/// One row per non-department page's hero banner AND SEO metadata combined
/// (a page has exactly one of each, so one table serves both rather than
/// two nearly-1:1 tables). Department pages keep using Department's own
/// heroImageUrl/metaTitle/etc. fields instead of this table.
model PageBanner {
  id              Int      @id @default(autoincrement())
  /// Free-text, unique key matching the frontend route it represents (e.g.
  /// "about", "contact", "naac"; NOT a DB enum - new pages are added to the
  /// frontend routinely and shouldn't require a migration to get a banner).
  pageKey         String   @unique
  title           String
  subtitle        String?
  eyebrow         String?
  imageUrl        String
  /// [{ "label": string, "href": string | null }, ...] - always edited as a
  /// whole unit per page, not independently CRUD'd row by row like
  /// LearningOutcome/DepartmentProgramme, so a Json column is used instead
  /// of a child table.
  breadcrumbs     Json?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("PageBanner_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Resolves a real data-quality bug found in the audit: the same figures
/// (years of institutional history, campus area, student count, department
/// count) are hardcoded independently on the homepage, About page, and
/// Alumni page, with DIFFERENT, CONFLICTING values on each (e.g. "45+" vs
/// "46+" years). One admin-editable source of truth per stat.
model SiteStatistic {
  id        Int      @id @default(autoincrement())
  /// Which page/section this stat belongs to (e.g. "homepage", "about",
  /// "alumni") - a lightweight grouping tag, not a full Category relation,
  /// since these groupings are page-specific rather than a shared taxonomy.
  scope     String
  label     String
  value     Int
  suffix    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("SiteStatistic_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([deletedAt])
}

/// The contact page's multiple named office contacts (Principal, Admissions,
/// Examination Cell, Placement Office, Main Office), each independently
/// hardcoded today - a repeating structure, unlike SiteSetting's singular
/// values, which is why this is its own table rather than more
/// awkwardly-named SiteSetting keys.
model ContactChannel {
  id          Int      @id @default(autoincrement())
  name        String
  phones      String[]
  emails      String[]
  address     String?
  mapEmbedUrl String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("ContactChannel_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  company   String?
  quote     String
  /// 1-5. Not enforced by a CHECK constraint in Phase 1 (Prisma's schema DSL
  /// doesn't express one directly) - validate at the application layer.
  rating    Int
  photoUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Testimonial_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

model CampusVideo {
  id         Int      @id @default(autoincrement())
  title      String
  youtubeUrl String
  /// Nullable - the public component falls back to a generic "Campus Video"
  /// label when unset. Replaces the previous by-array-position badge text,
  /// which silently mislabeled videos whenever they were reordered.
  badgeLabel String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("CampusVideo_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

model AccreditationBadge {
  id        Int      @id @default(autoincrement())
  shortName String
  grade     String?
  name      String
  subtext   String?
  linkUrl   String?
  linkText  String?
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("AccreditationBadge_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Company logos for the placements marquee - distinct from the Placement
/// model (which records individual student placements): this is purely
/// "logos of companies that recruit here" for marketing display.
model Recruiter {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Recruiter_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// No FAQ pattern exists anywhere on the site today (confirmed by the audit)
/// - seeded proactively per the "if a page has FAQs, the CMS should manage
/// them" instruction, ready for whenever one is built.
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  /// Nullable - null means a general/global FAQ not tied to one page.
  pageKey   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Faq_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([pageKey])
  @@index([isActive])
  @@index([deletedAt])
}

/// Institutional leadership (Chairman, Secretary cum Correspondent, Vice
/// Chairman & MD, Principal) - the About page's leadership cards plus their
/// individual /about/[slug] detail pages, currently hardcoded per-person in
/// the frontend with `generateStaticParams`.
model LeadershipProfile {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  role      String
  photoUrl  String
  email     String?
  shortBio  String?
  longBio   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("LeadershipProfile_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([deletedAt])
}

/// Deliberately generic, unlike every other model in this schema: covers
/// the long tail of one-off card/list patterns found in the audit (homepage
/// service cards, admission program highlight cards, IIC/EDC/RDC/Careers
/// objective-and-icon lists) that don't individually justify a dedicated
/// table. `section` is a namespaced convention key (e.g.
/// "homepage.services", "iic.objectives") coordinated between admins and
/// developers, not a DB-enforced taxonomy - a deliberate flexibility/
/// type-safety tradeoff flagged for review; if any one `section` grows a
/// genuinely distinct required shape, it should graduate to its own table.
model ContentCard {
  id          Int      @id @default(autoincrement())
  section     String
  icon        String?
  imageUrl    String?
  title       String?
  description String?
  /// e.g. branch-code pills on the homepage's admission program cards.
  tags        String[]
  linkUrl     String?
  linkText    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("ContentCard_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([section])
  @@index([isActive])
  @@index([deletedAt])
}
