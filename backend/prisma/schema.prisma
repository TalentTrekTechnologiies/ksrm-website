model Committee {
  id          Int           @id @default(autoincrement())
  name        String
  type        CommitteeType
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  deletedAt DateTime?
  deletedBy Int?
  version   Int       @default(1)

  deletedByAdmin Admin? @relation("Committee_DeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  members CommitteeMember[] @relation("CommitteeMember_Committee")

  @@unique([type, name])
  @@index([deletedAt])
