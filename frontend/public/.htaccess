# Apache/LiteSpeed config for the static export (Hostinger hPanel).
#
# Next's `output: "export"` emits FLAT files - /about -> about.html - and relies
# on the host mapping extensionless URLs onto them. Netlify does that
# automatically; Apache/LiteSpeed does not. This file lives in public/ so it is
# copied into out/ on every build and ships with the upload. Netlify ignores
# .htaccess entirely, so keeping it here is safe for both hosts.

# MultiViews would let the server pick about.html for /about on its own, but it
# also fights the explicit rewrite below - turn it off so routing is
# deterministic.
Options -MultiViews

# Do NOT auto-redirect /about to /about/. Many routes have BOTH a page file and
# a sibling folder (about.html AND about/ for /about/principal, admin/login.html
# AND admin/ ...). With DirectorySlash on, the server saw the folder first and
# 301'd /about -> /about/ -> a folder with no index -> 403. This is the whole
# reason inner pages and /admin/login failed on Hostinger.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# ---- Pretty URLs -> the exported .html files ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. A real file (an asset, a PDF, the .html itself) is served as-is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. An extensionless URL that has a matching .html file is served that file.
  #    This is checked BEFORE the directory rule below, so /about resolves to
  #    about.html even though an about/ folder also exists.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # 3. A real directory with no matching .html (a genuine asset folder) is
  #    served as-is.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Unknown URLs get the export's own 404 page.
ErrorDocument 404 /404.html

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # ---- Security headers ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
