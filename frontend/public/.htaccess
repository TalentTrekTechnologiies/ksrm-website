# Apache/LiteSpeed config for the static export (Hostinger hPanel).
#
# Next's `output: "export"` emits FLAT files - /about -> about.html - and relies
# on the host mapping extensionless URLs onto them. Netlify does that
# automatically; Apache/LiteSpeed does not. This file lives in public/ so it is
# copied into out/ on every build and ships with the upload. Netlify ignores
# .htaccess entirely, so keeping it here is safe for both hosts.

# MultiViews would let the server pick about.html for /about on its own, but it
# also fights the explicit rewrite below - turn it off so routing is
# deterministic.
Options -MultiViews

# Do NOT auto-redirect /about to /about/. Many routes have BOTH a page file and
# a sibling folder (about.html AND about/ for /about/principal, admin/login.html
# AND admin/ ...). With DirectorySlash on, the server saw the folder first and
# 301'd /about -> /about/ -> a folder with no index -> 403. This is the whole
# reason inner pages and /admin/login failed on Hostinger.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# ---- Pretty URLs -> the exported .html files ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ============================================================
  #  301 REDIRECTS from the OLD PHP site (the *.php pages that
  #  Google has indexed) to their new equivalents. This is what
  #  preserves the existing search rankings when this site
  #  replaces the old ksrmce.ac.in - an indexed old URL 301s to
  #  the right new page instead of 404ing. Runs BEFORE the
  #  pretty-URL rules below. Ambiguous ones point at the closest
  #  section - adjust if a better target exists.
  # ============================================================
  RewriteRule ^index\.php$ / [R=301,L]

  # Departments
  RewriteRule ^cen\.php$  /departments/civil [R=301,L]
  RewriteRule ^csen\.php$ /departments/cse [R=301,L]
  RewriteRule ^eeen\.php$ /departments/eee [R=301,L]
  RewriteRule ^ecen\.php$ /departments/ece [R=301,L]
  RewriteRule ^mech\.php$ /departments/mech [R=301,L]
  RewriteRule ^hasn\.php$ /departments/hs [R=301,L]
  RewriteRule ^MBA\.php$  /departments/mba [R=301,L]

  # About & leadership (the . matches the space in the old filenames)
  RewriteRule ^college\.php$ /about [R=301,L]
  RewriteRule ^Correspondent.Maam\.php$ /about/correspondent [R=301,L]
  RewriteRule ^director\.php$ /about/managing-director [R=301,L]
  RewriteRule ^vice.chairman.sir\.php$ /about/chairman [R=301,L]
  RewriteRule ^principal\.php$ /about/principal [R=301,L]
  RewriteRule ^jbos\.php$ /about [R=301,L]

  # Academics
  RewriteRule ^academic\.php$ /academics/courses-intake [R=301,L]
  RewriteRule ^admission\.php$ /admissions [R=301,L]
  RewriteRule ^fee\.php$ /academics/fee-structure [R=301,L]
  RewriteRule ^examportal\.php$ /academics/academic-calendar [R=301,L]
  RewriteRule ^SyllabusAll\.php$ /academics/syllabus [R=301,L]
  RewriteRule ^regulations\.php$ /academics/regulations [R=301,L]

  # Quality / NAAC (no direct new page for NIRF/ARIIA/DVV -> closest)
  RewriteRule ^iqac\.php$ /iqac [R=301,L]
  RewriteRule ^NAAC\.php$ /naac [R=301,L]
  RewriteRule ^DVV2\.php$ /naac [R=301,L]
  RewriteRule ^nirf\.php$ /accreditation [R=301,L]
  RewriteRule ^ARIIA\.php$ /accreditation [R=301,L]

  # Training & Placements
  RewriteRule ^tap\.php$ /placements/overview [R=301,L]
  RewriteRule ^partners\.php$ /placements/our-recruiters [R=301,L]
  RewriteRule ^pprecord\.php$ /placements/placements-record [R=301,L]
  RewriteRule ^pptraining\.php$ /placements/trainings [R=301,L]
  RewriteRule ^tapregistration\.php$ /placements [R=301,L]
  RewriteRule ^ctap\.php$ /contact [R=301,L]

  # Campus life
  RewriteRule ^campusnew\.php$ /campus-life/campus-facilities [R=301,L]
  RewriteRule ^edc\.php$ /edc [R=301,L]
  RewriteRule ^nss\.php$ /campus-life/nss [R=301,L]
  RewriteRule ^startup\.php$ /campus-life/startup-cell [R=301,L]
  RewriteRule ^libruf2\.php$ /campus-life/library [R=301,L]
  RewriteRule ^hostel\.php$ /campus-life/hostels [R=301,L]
  RewriteRule ^transport\.php$ /campus-life/transport [R=301,L]
  RewriteRule ^sport\.php$ /campus-life/sports [R=301,L]
  RewriteRule ^antiragging\.php$ /campus-life/anti-ragging [R=301,L]
  RewriteRule ^grievancecell\.php$ /campus-life/grievance [R=301,L]
  RewriteRule ^cultural\.php$ /campus-life/cultural [R=301,L]

  # Old-site pages still linked to from the new site's own content (IQAC's
  # feedback forms, governing body, etc). Without these they 404 the moment the
  # new site replaces the old one, because the linked .php files stop existing.
  RewriteRule ^AlumniFeedback\.php$ /iqac/\#survey [NE,R=301,L]
  RewriteRule ^StudentFeedback\.php$ /iqac/\#survey [NE,R=301,L]
  RewriteRule ^ParentFeedback\.php$ /iqac/\#survey [NE,R=301,L]
  RewriteRule ^TeacherFeedback\.php$ /iqac/\#survey [NE,R=301,L]
  RewriteRule ^EmployerFeedback\.php$ /iqac/\#survey [NE,R=301,L]
  RewriteRule ^gbody\.php$ /committees/\#governing-body [NE,R=301,L]
  RewriteRule ^academiccouncil\.php$ /committees/\#academic-council [NE,R=301,L]
  RewriteRule ^financial\.php$ /committees/\#finance-committee [NE,R=301,L]
  RewriteRule ^alumniregistration\.php$ /alumni [R=301,L]

  # Other
  RewriteRule ^alumniruf\.php$ /alumni [R=301,L]
  RewriteRule ^enquiry\.php$ /contact [R=301,L]
  RewriteRule ^kgcet\.php$ /kgcet [R=301,L]
  RewriteRule ^reports\.php$ /iqac/\#annual-reports [NE,R=301,L]
  RewriteRule ^feedback\.php$ /iqac/\#survey [NE,R=301,L]

  # 1. A real file (an asset, a PDF, the .html itself) is served as-is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. An extensionless URL that has a matching .html file is served that file.
  #    This is checked BEFORE the directory rule below, so /about resolves to
  #    about.html even though an about/ folder also exists.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # 3. A real directory with no matching .html (a genuine asset folder) is
  #    served as-is.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Department URL aliases. Nginx has matching rules in deploy/nginx-redirects.conf.
  RewriteRule ^departments/(aids|ai-ds|aiml|ai-ml|data-science|cse-ds|cse-aiml)/?$ /departments/cse [R=301,L]
  RewriteRule ^departments/mechanical/?$ /departments/mech [R=301,L]
  RewriteRule ^departments/humanities-sciences/?$ /departments/hs [R=301,L]
</IfModule>

# Unknown URLs get the export's own 404 page.
ErrorDocument 404 /404.html

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # ---- Security headers ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
