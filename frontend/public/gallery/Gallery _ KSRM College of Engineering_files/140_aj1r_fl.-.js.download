        .placements-container {
          max-width: 1400px;
          margin: 0 auto;
          padding: 0 16px;
        }
        @media (min-width: 768px) {
          .placements-container {
            padding: 0 32px;
          }
        }
        .placements-heading {
          font-family: 'Rajdhani', sans-serif;
          font-size: clamp(2rem, 4vw, 3rem);
          font-weight: 700;
          color: #2B3490;
          margin: 0 0 8px;
          text-align: center;
        }
        .placements-subtitle {
          font-size: 16px;
          color: #666;
          text-align: center;
          margin: 0 0 48px;
          max-width: 600px;
          margin-left: auto;
          margin-right: auto;
        }
        .stats-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
          gap: 28px;
          margin-bottom: 64px;
        }
        .stat-card {
          background: #fff;
          border-radius: 12px;
          padding: 28px;
          text-align: center;
          border: 1px solid #eef0f3;
          transition: all 0.3s;
        }
        .stat-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 12px 32px rgba(43, 52, 144, 0.1);
        }
        .stat-number {
          font-family: 'Rajdhani', sans-serif;
          font-size: 36px;
          font-weight: 700;
          color: #1e2a78;
          line-height: 1;
          margin-bottom: 8px;
        }
        .stat-label {
          font-size: 14px;
          color: #666;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 0.5px;
        }
        .scroll-section {
          margin-bottom: 24px;
          text-align: center;
        }
        .scroll-label {
          font-size: 14px;
          color: #1e2a78;
          font-weight: 700;
          letter-spacing: 1px;
          text-transform: uppercase;
          margin-bottom: 16px;
          display: inline-block;
          background: #D4A500;
          padding: 6px 16px;
          border-radius: 20px;
          margin-left: auto;
          margin-right: auto;
          width: fit-content;
        }
        .poster-wrapper {
          position: relative;
          overflow-x: auto;
          overflow-y: hidden;
          border-radius: 16px;
          background: #fff;
          padding: 8px;
          -webkit-overflow-scrolling: touch;
        }
        .poster-track {
          display: flex;
          gap: 24px;
          width: max-content;
          animation: scrollX 50s linear infinite;
          padding: 0;
        }
        .poster-track:hover {
          animation-play-state: paused;
        }
        .poster-item {
          flex: 0 0 auto;
          width: 260px;
          height: 260px;
          border-radius: 12px;
          overflow: hidden;
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
          transition: transform 0.3s ease;
          cursor: pointer;
        }
        .poster-item:hover {
          transform: scale(1.05);
          box-shadow: 0 12px 32px rgba(43, 52, 144, 0.2);
        }
        .poster-item img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }
        @keyframes scrollX {
          from {
            transform: translateX(0);
          }
          to {
            transform: translateX(-50%);
          }
        }
        .cta-button {
          display: inline-block;
          background: #D4A500;
          color: #1a1a2e;
          padding: 16px 40px;
          border-radius: 8px;
          font-weight: 700;
          text-decoration: none;
          transition: all 0.2s;
          font-family: 'Rajdhani', sans-serif;
          font-size: 16px;
          cursor: pointer;
          border: none;
          margin-top: 4px;
        }
        .cta-button:hover {
          background: #2B3490;
          color: #D4A500;
          transform: translateY(-2px);
          box-shadow: 0 8px 24px rgba(255, 230, 25, 0.3);
        }
        .cta-wrapper {
          text-align: center;
        }
        .marquee {
          overflow: hidden;
        }
        .marquee-track {
          display: flex;
          gap: 1.5rem;
          width: max-content;
          animation: scroll 30s linear infinite;
        }
        .marquee:hover .marquee-track {
          animation-play-state: paused;
        }
        @keyframes scroll {
          from {
            transform: translateX(0);
          }
          to {
            transform: translateX(-50%);
          }
        }
        @media (max-width: 768px) {
          .poster-item {
            width: 200px;
            height: 200px;
          }
          .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
          }
          .stat-number {
            font-size: 28px;
          }
          /* Keep auto-scroll animation on mobile, smooth scrolling behavior */
          .poster-track {
            animation: scrollX 50s linear infinite;
            scroll-behavior: smooth;
          }
          .poster-track:hover {
            animation-play-state: paused;
          }
          /* Hide duplicate posters on mobile */
          .poster-track > div:nth-child(n + 10) {
            display: none;
          }
          .recruiter-logos {
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
          }
        }
