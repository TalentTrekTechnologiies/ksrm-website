        .gal-hero {
          position: relative;
          background-image: url('/gallery/sports/sportsground2.jpg');
          background-size: cover;
          background-position: center;
          background-color: #2B3490;
          min-height: 280px;
          display: flex;
          align-items: flex-end;
          padding-bottom: 40px;
          overflow: hidden;
        }
        .gal-hero::after {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          height: 100%;
          background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.4) 100%);
          pointer-events: none;
        }
        .gal-hero > * {
          position: relative;
          z-index: 2;
        }
        .gal-breadcrumb {
          display: flex;
          align-items: center;
          gap: 8px;
          font-size: 14px;
          color: rgba(255,255,255,0.7);
          margin-bottom: 24px;
        }
        .gal-breadcrumb a {
          color: #D4A500;
          text-decoration: none;
          transition: color 0.2s;
        }
        .gal-breadcrumb a:hover {
          color: #fff;
        }
        .gal-filters {
          display: flex;
          gap: 12px;
          margin: 32px 0;
          flex-wrap: wrap;
        }
        .gal-filter-btn {
          background: #f7f8fa;
          border: 1px solid #eef0f3;
          color: #2B3490;
          padding: 12px 24px;
          border-radius: 24px;
          font-weight: 600;
          cursor: pointer;
          font-family: 'Rajdhani', sans-serif;
          transition: all 0.2s;
        }
        .gal-filter-btn.active {
          background: #2B3490;
          color: #D4A500;
          border-color: #2B3490;
        }
        .gal-filter-btn:hover {
          background: #2B3490;
          color: #D4A500;
          border-color: #2B3490;
        }
        .gal-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 24px;
          margin: 32px 0;
        }
        .gal-card {
          background: #f7f8fa;
          border: 1px solid #eef0f3;
          border-radius: 12px;
          overflow: hidden;
          transition: all 0.2s;
          cursor: pointer;
        }
        .gal-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 12px 32px rgba(43,52,144,0.1);
        }
        .gal-card-image {
          width: 100%;
          height: 200px;
          display: flex;
          align-items: center;
          justify-content: center;
          position: relative;
          overflow: hidden;
        }
        .gal-card-overlay {
          position: absolute;
          inset: 0;
          background: rgba(0,0,0,0.2);
          opacity: 0;
          transition: opacity 0.2s;
        }
        .gal-card:hover .gal-card-overlay {
          opacity: 1;
        }
        .gal-card-content {
          padding: 16px;
        }
        .gal-card-title {
          font-family: 'Rajdhani', sans-serif;
          font-size: 16px;
          font-weight: 700;
          color: #2B3490;
          margin: 0 0 8px;
        }
        .gal-card-meta {
          display: flex;
          justify-content: space-between;
          align-items: center;
          font-size: 13px;
          color: #999;
        }
        @media (max-width: 1200px) {
          .gal-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 768px) {
          .gal-grid { grid-template-columns: 1fr; }
          .gal-filters { gap: 8px; }
          .gal-filter-btn { padding: 10px 16px; font-size: 13px; }
        }
      `}),(0,t.jsx)("section",{className:"gal-hero",children:(0,t.jsx)(n.default,{children:(0,t.jsxs)(r.motion.div,{initial:"hidden",animate:"visible",variants:p,children:[(0,t.jsxs)("div",{className:"gal-breadcrumb",style:{marginBottom:16,textShadow:"0 2px 8px rgba(0,0,0,0.6)"},children:[(0,t.jsx)("a",{href:"/",children:"Home"}),(0,t.jsx)("span",{children:"/"}),(0,t.jsx)("span",{children:"Gallery"})]}),(0,t.jsx)(r.motion.h1,{variants:d,style:{fontFamily:"'Rajdhani', sans-serif",fontSize:"clamp(2.2rem, 4.5vw, 3.6rem)",fontWeight:700,color:"#fff",lineHeight:1.08,margin:0,textShadow:"0 2px 12px rgba(0,0,0,0.7)"},children:"Campus Gallery"}),(0,t.jsx)(r.motion.p,{variants:d,style:{color:"rgba(255,255,255,0.85)",fontSize:18,lineHeight:1.6,margin:"16px 0 0",fontWeight:300,maxWidth:"100%",textShadow:"0 2px 8px rgba(0,0,0,0.6)"},children:"Explore life at KSRM College of Engineering"})]})})}),(0,t.jsx)("section",{style:{padding:"48px 0",background:"#ffffff"},children:(0,t.jsx)(n.default,{children:(0,t.jsx)(r.motion.div,{initial:"visible",animate:"visible",variants:d,children:(0,t.jsx)("div",{className:"gal-filters",children:c.galleryCategories.map(r=>(0,t.jsx)("button",{className:`gal-filter-btn ${e===r?"active":""}`,onClick:()=>{g(r),m(!1),f(0)},children:r},r))})})})}),(0,t.jsx)("section",{style:{padding:"72px 0",background:"#f7f8fa"},children:(0,t.jsx)(n.default,{children:(0,t.jsx)(r.motion.div,{initial:"visible",animate:"visible",variants:p,children:v.length>0?(0,t.jsx)(a.AnimatePresence,{children:(0,t.jsx)(r.motion.div,{variants:p,initial:"visible",animate:"visible",className:"gal-grid",children:v.map((a,i)=>(0,t.jsxs)(r.motion.div,{variants:d,initial:"visible",animate:"visible",className:"gal-card",layout:!0,onClick:()=>{f(i),m(!0)},children:[(0,t.jsxs)("div",{className:"gal-card-image",style:{background:"transparent",overflow:"hidden",position:"relative"},children:[(0,t.jsx)("img",{src:a.src,alt:a.alt,loading:"lazy",style:{width:"100%",height:"200px",objectFit:"cover",