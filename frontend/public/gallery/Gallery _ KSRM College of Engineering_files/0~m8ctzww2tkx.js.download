hildren:[(0,i.jsx)("style",{children:`
        .cultural-hero { position: relative; background-image: url('/banners/cultural-banner.jpg'); background-size: cover; background-position: center; background-color: #2B3490; min-height: 320px; display: flex; align-items: flex-end; padding-bottom: 40px; overflow: hidden; }
        .cultural-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.55) 100%); z-index: 1; }
        .cultural-hero > * { position: relative; z-index: 2; }
        .cultural-title { font-family: 'Rajdhani', sans-serif; font-size: clamp(2.2rem, 4.5vw, 3.6rem); font-weight: 700; color: #fff; margin: 0; text-shadow: 0 2px 12px rgba(0,0,0,0.7); line-height: 1.08; }
        .cultural-subtitle { color: rgba(255,255,255,0.95); font-size: 18px; margin: 16px 0 0; text-shadow: 0 2px 8px rgba(0,0,0,0.6); }
        .cultural-about { padding: 72px 0; background: #ffffff; }
        .cultural-about-text { font-size: 16px; color: #555; line-height: 1.8; text-align: justify; max-width: 900px; margin: 0 auto; }
        .cultural-events { padding: 72px 0; background: #f4f3ef; }
        .cultural-heading { font-family: 'Rajdhani', sans-serif; font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 700; color: #2B3490; margin: 0 0 48px; text-align: center; }
        .cultural-events-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; margin-top: 40px; }
        .cultural-event-card { background: #fff; padding: 28px; border-radius: 8px; border-top: 3px solid #D4A500; box-shadow: 0 4px 20px rgba(43, 52, 144, 0.08); transition: all 0.3s; }
        .cultural-event-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(43, 52, 144, 0.12); }
        .cultural-event-icon { font-size: 36px; margin-bottom: 12px; }
        .cultural-event-card h3 { font-family: 'Rajdhani', sans-serif; font-size: 18px; font-weight: 700; color: #2B3490; margin: 0 0 8px; }
        .cultural-event-card p { font-size: 14px; color: #666; line-height: 1.6; margin: 0; }
        .cultural-committee { padding: 72px 0; background: #ffffff; }
        .cultural-committee-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 40px; }
        .cultural-member-card { background: linear-gradient(135deg, #2B3490 0%, #1e2570 100%); color: #fff; padding: 28px; border-radius: 8px; text-align: center; }
        .cultural-member-card h4 { font-family: 'Rajdhani', sans-serif; font-size: 16px; font-weight: 700; margin: 0; }
        .cultural-member-card p { font-size: 13px; margin: 4px 0; opacity: 0.9; }
        @media (max-width: 768px) { .cultural-events-grid { grid-template-columns: 1fr; } .cultural-committee-grid { grid-template-columns: 1fr; } }
