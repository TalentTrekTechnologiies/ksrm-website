        .responsive-container {
          width: 100%;
          max-width: 1400px;
          margin: 0 auto;
          padding-left: 40px;
          padding-right: 40px;
        }
        @media (max-width: 1024px) {
          .responsive-container {
            padding-left: 32px;
            padding-right: 32px;
          }
        }
        @media (max-width: 768px) {
          .responsive-container {
            padding-left: 20px;
            padding-right: 20px;
          }
        }
        @media (max-width: 480px) {
          .responsive-container {
            padding-left: 14px;
            padding-right: 14px;
          }
        }
