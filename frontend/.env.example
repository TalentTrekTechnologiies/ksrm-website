# Frontend environment variables.
# All NEXT_PUBLIC_* values are baked into the static build, so after changing
# any of these you must rebuild (npm run build / npm run zip).
# Copy this file to .env.local and fill in the values.

# Backend API origin. Leave blank to use the built-in production fallback
# (https://ksrm-backend.onrender.com). In production set this to your VPS
# backend URL, e.g. https://api.ksrmce.ac.in
NEXT_PUBLIC_API_URL=

# --- Digital marketing (optional; leave blank to disable) ---

# Google Analytics 4 Measurement ID from analytics.google.com (looks like
# G-XXXXXXXXXX). Blank = no analytics loaded at all.
NEXT_PUBLIC_GA_ID=

# Google Search Console ownership token. In Search Console pick the "HTML tag"
# verification method and paste ONLY the content="..." value here. Blank = no
# verification meta tag emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
