# Dependencies
frontend/node_modules/
backend/node_modules/

# Next.js build
frontend/.next/
frontend/out/
frontend/build/

# Backend build
backend/dist/

# Environment files
frontend/.env*
backend/.env*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Local editor/tooling config
.claude/
.cursor/
.aider*

# Editor settings (per-developer)
.vscode/

# TypeScript incremental build info
*.tsbuildinfo

# Raw source assets - kept locally, never tracked.
# These are the unoptimised originals that the files in frontend/public were
# derived from. 385MB across 66 files, referenced by no source file. They were
# purged from history because they made cloning painful for no benefit.
assets-archive/

# The 100.7MB QuickTime splash video. GitHub hard-rejects any file over 100MiB
# (this one missed by 0.7MiB and blocked the entire push), and it was dead
# weight regardless: it sat as a <source> fallback *after* ksrm-logo.mp4 (266KB)
# in IntroSplash.tsx, and video/quicktime plays in no major browser but Safari -
# which takes the mp4 first anyway. The mp4 is the real asset; keep using it.
frontend/public/*.mov

# Local Hostinger deploy artifact - large, never commit
ksrm-site.zip
ksrm-site-updated.zip

# Database dumps - NEVER commit. These carry live production data: the Admin
# table's bcrypt password hashes, CareerApplication rows with applicants'
# personal details, and the full AuditLog. Pushing one to this repo would
# publish real credentials. Keep them on disk; move them with scp, not git.
*.sql
*.sql.bak
# ...but Prisma's migrations ARE source and must stay tracked. Without this
# exception the blanket *.sql rule above silently swallows every new
# migration, and the schema stops being reproducible from a fresh clone.
!backend/prisma/migrations/**/*.sql

# Deployment content scripts are source too: hand-written, reviewed, and
# carrying no credentials - only INSERTs for CMS content. They have to reach
# the server to be run, and a git pull is safer than emailing a .sql around.
# This is NOT a hole in the dump rule above: a pg_dump is named
# ksrm_db_dump.sql / *.bak and stays ignored.
!deploy-data.sql
!deploy-routes-only.sql
!fix-media-urls.sql
!deploy-committees.sql
!import-library-exam-staff.sql
!import-nss-activities.sql
!import-nss-committee.sql

# Media Library uploads - user-uploaded files, served from the backend's own
# storage root. Reproducible from the running instance, not source.
backend/storage/

# Scraped reference image from another college's site; not ours to ship.
frontend/iare_faculty.png

# One-off export of the Mandatory Disclosure PDFs for uploading to the VPS by
# hand (19MB of binaries). The files live in the Media Library; this folder is
# a convenience copy, regenerated whenever it is needed - not source.
deploy-pdfs/

# Source PDFs handed over for uploading (academic calendars and the like).
# They live in the Media Library once uploaded - backend/storage, which is
# already ignored - so the copies here are a handover folder, not source.
uploaded-calendars/

# Unscrubbed recording behind the client specimen - never committed.
scratchpad/demo-raw.json

# The built specimen - regenerate with `npm run demo`, never committed.
frontend/demo-out/
ksrmce-specimen.zip
